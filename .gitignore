# Test results and playwright reports
test-results/
playwright-report/

# Electron build output (large binaries — not for git)
dist-installer/

# Test databases and screenshots (generated, not source)
tests/screenshots/
tests/*.db

# TypeScript incremental build cache
tsconfig.app.tsbuildinfo
tsconfig.node.tsbuildinfo

# Workspace data (user-specific runtime state)
workspaces/

# ANTON orchestrator runtime trails (generated at runtime)
.anton/

# Portable bundle — downloaded runtimes + first-run DB + output zip.
# These are NOT committed to git; they only exist to be swept into the
# distributable zip by scripts/portable/. See docs/PORTABLE_BUNDLE.md.
node/
pgsql/
ollama/
pgdata/
.portable-tmp/
.portable-run/
ANTON-portable*.zip

# Capacitor web-build output — generated by `pnpm build:<app>:cap` + the
# copy step in CLAUDE_ANTON_BUSINESS.md §15. Versioning minified bundles
# bloated history and produced a meaningless diff on every rebuild.
android-business/app/src/main/assets/public/
android-pay/app/src/main/assets/public/
android-comm/app/src/main/assets/public/

# Test-corpus documents — downloaded on demand by
# `node data/test-corpus/<jurisdiction>/scripts/fetch-government-docs.cjs`.
# Crown Copyright / OGL documents could in principle be committed, but
# keeping the docs/ dirs out of the repo keeps things consistent across
# jurisdictions (some corpora include non-redistributable corporate docs)
# and stops binary-PDF noise in diffs.
data/test-corpus/*/docs/*
!data/test-corpus/*/docs/.gitkeep

# Scratch on-device driving scripts (superseded by tests/device/)
.live-walk/

# ANTON Studio scratch workspaces (dogfood runs)
.studio-workspaces/

# Local-only design docs / specs — kept out of the public repo.
not_to_github/

# Pay / Business / Comm app source — shipped via the App Store, kept OUT of the
# public repo (still present + buildable locally; their vite/capacitor configs +
# package.json scripts remain so local dev is unaffected).
/src/comm/
/src/pay/
/src/business/
/android-comm/
/android-pay/
/android-business/

# ANTON Agent app (WIP) — kept fully OUT of the public repo for now: source,
# native project, AND its build configs (unlike the older apps whose configs
# stayed tracked). Buildable locally; nothing leaks until it's ready.
/src/agent/
/android-agent/
/vite.config.agent.ts
/vitest.config.agent.ts
/capacitor.config.agent.ts
/dist/agent/

# Internal design/session docs — kept local only. The core dev docs
# (docs/architecture/, docs/anton-format/, docs/help/, ARCHITECTURE.md,
# API_REFERENCE.md, deployment.md, etc.) STAY tracked. gitignore '*' doesn't
# cross '/', so these root patterns never touch the kept subdirs.
docs/audit/
docs/marketing/
docs/*PLAN*.md
docs/*AUDIT*.md
docs/*REVIEW*.md
docs/*INVESTIGATION*.md
docs/*READINESS*.md
docs/*SWEEP*.md
docs/PORTFOLIO_*.md
docs/HANDOFF_*.md
# Session handovers map keystore locations + credential paths — local-only ops docs
# (the *HANDOVER* variant the HANDOFF_ pattern above missed).
docs/*HANDOVER*.md
