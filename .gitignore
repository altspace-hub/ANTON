data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/*.db
data/.vault-key
data/user-knowledge-packs/
*.log
.DS_Store
Thumbs.db

# Security audit reports
audit-report.json
vulnerability-report.json
LICENSES.csv
licenses-report.csv
to_git_repo/

# Claude Code local memory (not for the repo)
.claude/

# Local-only scratch files and scripts (not for the repo)
not_to_git/

# Release signing — keystores + their properties stay off the repo.
# Keep `keystore.properties.example` (no real values) tracked.
*.keystore
*.jks
keystore.properties

