<?xml version="1.0" encoding="utf-8"?>
<!--
  ANTON Companion launcher foreground (Android 8+ adaptive icon).

  Matches the in-app brand mark (public/anton-logo.svg): a single white
  "A" letterform centred on the green background.

  The A is drawn as three subpaths combined with evenodd fill:
    1. Outer triangle — the A's silhouette
    2. Upper triangular hole — the negative space above the crossbar
    3. Lower trapezoidal hole — the gap between the legs below the crossbar

  Where the three subpaths overlap with even parity, evenodd subtracts;
  the remaining odd-parity area renders the legs + crossbar as a solid
  white "A" shape.

  Geometry mapped to the 108×108 adaptive-icon viewport. The whole "A"
  fits inside the centred 72×72 safe zone the launcher guarantees not
  to clip.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
  <path
      android:fillColor="#FFFFFF"
      android:fillType="evenOdd"
      android:pathData="M28,84 L54,24 L80,84 Z M44,58 L54,32 L64,58 Z M40,84 L44,66 L64,66 L68,84 Z" />
</vector>
