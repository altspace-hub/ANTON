<?xml version="1.0" encoding="utf-8"?>
<!--
  ANTON Companion launcher foreground (Android 8+ adaptive icon).

  Faithful recreation of the stock Capacitor template's two-L design,
  recoloured from blue to ANTON greens. The original icon shows two
  interlocking L-shaped (or Γ-shaped) connectors:
    - lighter cyan in the bottom-left, opening up-right
    - darker blue in the top-right, opening down-left
  They overlap at the centre to form an "X" silhouette of two pieces
  reaching toward each other.

  Geometry mapped to the 108×108 adaptive-icon viewport with the icon
  filling the centred 72×72 safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">

  <!-- Lighter (front-bottom) L — opens up-right, sits in bottom-left.
       Drawn first so the darker piece lays on top of it at the centre
       overlap, mirroring the front/back relationship in the original. -->
  <path
      android:fillColor="#0D7D6C"
      android:pathData="M50,30 L50,78 L24,78 L24,66 L38,66 L38,30 Z" />

  <!-- Darker (back-top) L — opens down-left, sits in top-right. -->
  <path
      android:fillColor="#06655A"
      android:pathData="M58,30 L84,30 L84,42 L70,42 L70,78 L58,78 Z" />
</vector>
