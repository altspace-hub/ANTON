<?xml version="1.0" encoding="utf-8"?>
<!--
    ANTON Companion App — adaptive launcher icon (API 26+).

    Background: drawable/ic_launcher_background.xml — solid cream #F5F1EA.
    Foreground: drawable-v24/ic_launcher_foreground.xml — three teal chevrons.

    Both are vector drawables (no PNG fallback needed since minSdk=26
    and adaptive icons are always available there).

    Geometry source: logo_app/icon-launcher-master.svg.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
