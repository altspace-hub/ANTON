<?xml version="1.0" encoding="utf-8"?>
<!--
    ANTON Companion App — adaptive launcher foreground.

    Three white chevrons rising in opacity (0.45 → 0.75 → 1.0).
    Geometry mirrors logo_app/icon-launcher-master.svg (1024 canvas)
    scaled to the 108dp adaptive-icon canvas. Chevrons span 22.5→85.5dp
    horizontally — within the 66dp safe zone Android masks against, so
    no chevron clips on any launcher shape (circle / squircle / square).

    Stroke 11.7dp ≈ 111/1024 of the master.

    Referenced from mipmap-anydpi-v26/ic_launcher.xml + ic_launcher_round.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top chevron, opacity 0.45 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11.7"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:strokeAlpha="0.45"
        android:fillColor="#00000000"
        android:pathData="M22.5,49.5 L54,25 L85.5,49.5" />

    <!-- Middle chevron, opacity 0.75 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11.7"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:strokeAlpha="0.75"
        android:fillColor="#00000000"
        android:pathData="M22.5,67.5 L54,43 L85.5,67.5" />

    <!-- Bottom chevron, full opacity -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="11.7"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:fillColor="#00000000"
        android:pathData="M22.5,85.5 L54,61 L85.5,85.5" />
</vector>
