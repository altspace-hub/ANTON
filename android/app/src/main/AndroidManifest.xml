<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: anton://enroll?server=...&token=...  (modern pairing per spec §5.2) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anton" android:host="enroll" />
            </intent-filter>

            <!-- Legacy deep link: anton://join?server=...&token=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anton" android:host="join" />
            </intent-filter>

            <!-- NO https App Link filter here, deliberately. Do not "restore" one.
                 There used to be an autoVerify intent filter for scheme https
                 with two pathPrefixes and NO android:host. Android's data-element
                 merge rule is that when a filter names no host, the port and ALL
                 path attributes are ignored — so that filter did not match
                 /anton/enroll, it matched EVERY https URI on the device, putting
                 Companion in the chooser for every web link (a Play-review flag
                 as well as a phishing surface). autoVerify could never succeed
                 either: verification needs a domain to fetch
                 /.well-known/assetlinks.json from, and there is none — every
                 deployment's pairing host is the operator's own
                 (APP_GATEWAY_PUBLIC_URL), unknown at build time. Pairing links
                 are minted as anton://enroll?... (see
                 src/pages/AppGatewayPage.tsx), which the custom-scheme filters
                 above already handle. If a hosted deployment ever wants true App
                 Links, add a filter with that deployment's explicit android:host
                 and serve assetlinks.json from it.
                 Guarded by tests/android/manifest-deep-links.test.ts. -->

            <!-- Share target — receive text / urls / images from the OS share sheet (spec §8.5) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- FCM-pushed notifications use the ANTON chevron, not the app icon. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
    </application>

    <!-- ── Permissions per ANTON_COMPANION_APP_SPEC.md §7.2 ─────────────── -->

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Capture surface (camera, voice memo) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Biometric unlock for credentials (spec §5.4) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Push notifications (spec §8.7) — Android 13+ runtime permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- RECEIVE_BOOT_COMPLETED removed: no boot-time receiver registered. -->

    <!-- Android 11+ package visibility — needed for share plugin to enumerate
         installable text/image/PDF receivers via the OS share sheet. Without
         this, Capacitor's share plugin returns an empty target list. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

    <!-- Long-running voice sessions on offline NGO deployments (spec §8.7 fallback) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- mDNS LAN discovery (spec §5.1 Mode A) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- We deliberately do NOT request: ACCESS_FINE_LOCATION (Data Safety
         consequences), BLUETOOTH_*, or any READ_EXTERNAL_STORAGE legacy perm. -->

    <!-- Hardware features — declared as non-required so cheap NGO devices without
         them can still install (spec §4.3) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
