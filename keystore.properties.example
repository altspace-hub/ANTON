# Copy this file to `keystore.properties` (gitignored) and fill in the
# values for your release keystore. The Comm App build.gradle reads it
# only when present — debug builds still work without it.
#
# Generate a keystore (one-time):
#   keytool -genkeypair -v \
#     -keystore anton-comm-release.keystore \
#     -alias anton-comm -keyalg RSA -keysize 4096 -validity 36500
#
# Store the .keystore file outside the repo. Path is resolved relative
# to the repo root.

storeFile=../anton-comm-release.keystore
storePassword=CHANGE_ME
keyAlias=anton-comm
keyPassword=CHANGE_ME
