{
  "formatVersion": "1.0",
  "id": "code-review-checklist",
  "label": "Code Review Checklist Generator",
  "shortLabel": "Review Checklist",
  "description": "Generates comprehensive, language/framework-specific code review checklists from PR descriptions or changed file summaries. Covers security, performance, maintainability, and test coverage.",
  "icon": "ClipboardCheck",
  "color": "adv-teal",
  "areaId": "software-eng",
  "perspective": "operational",
  "defaults": {
    "thinking": "think",
    "creativity": "strict",
    "outputFormats": [
      "action-plan",
      "detailed-findings"
    ],
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": ""
      }
    }
  },
  "guidedInputs": [
    {
      "id": "language",
      "type": "select",
      "label": "Primary language / framework",
      "required": true,
      "options": [
        {
          "value": "typescript",
          "label": "TypeScript / JavaScript"
        },
        {
          "value": "python",
          "label": "Python"
        },
        {
          "value": "java",
          "label": "Java / Kotlin"
        },
        {
          "value": "csharp",
          "label": "C# / .NET"
        },
        {
          "value": "go",
          "label": "Go"
        },
        {
          "value": "rust",
          "label": "Rust"
        },
        {
          "value": "cpp",
          "label": "C / C++"
        },
        {
          "value": "swift",
          "label": "Swift"
        },
        {
          "value": "ruby",
          "label": "Ruby"
        },
        {
          "value": "php",
          "label": "PHP"
        },
        {
          "value": "sql",
          "label": "SQL"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "id": "framework",
      "type": "text",
      "label": "Framework or platform (optional)",
      "placeholder": "e.g., React, Django, Spring Boot, Next.js, FastAPI, Rails"
    },
    {
      "id": "change_type",
      "type": "select",
      "label": "Type of change being reviewed",
      "required": true,
      "options": [
        {
          "value": "new_feature",
          "label": "New feature"
        },
        {
          "value": "bug_fix",
          "label": "Bug fix"
        },
        {
          "value": "refactoring",
          "label": "Refactoring / cleanup"
        },
        {
          "value": "api_change",
          "label": "API change (breaking or additive)"
        },
        {
          "value": "security_fix",
          "label": "Security fix / hardening"
        },
        {
          "value": "performance",
          "label": "Performance optimisation"
        },
        {
          "value": "infra",
          "label": "Infrastructure / DevOps change"
        },
        {
          "value": "dependency_update",
          "label": "Dependency update"
        }
      ]
    },
    {
      "id": "pr_description",
      "type": "textarea",
      "label": "PR title and description",
      "required": true,
      "placeholder": "Paste the pull request title and description here. Include what changed, why, and any relevant context."
    },
    {
      "id": "changed_files",
      "type": "textarea",
      "label": "Changed files summary (optional)",
      "placeholder": "e.g., src/auth/login.ts (+120 -45), src/db/queries.ts (+55 -10), tests/auth.test.ts (+80)"
    },
    {
      "id": "team_standards",
      "type": "textarea",
      "label": "Team standards or constraints",
      "placeholder": "e.g., We enforce 80% test coverage, use ESLint strict, follow REST conventions, require OpenAPI spec updates for API changes"
    }
  ],
  "recommendedPersonas": [
    "tech-expert"
  ],
  "tags": [
    "code-review",
    "checklist",
    "pull-request",
    "quality",
    "security",
    "testing"
  ]
}
