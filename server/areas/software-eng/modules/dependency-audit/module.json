{
  "formatVersion": "1.0",
  "id": "dependency-audit",
  "label": "Dependency Security Audit",
  "shortLabel": "Dependency Audit",
  "description": "Analyzes package dependencies for security vulnerabilities, outdated versions, and license compliance. Prioritizes updates by severity and produces remediation plan.",
  "icon": "PackageSearch",
  "color": "adv-teal",
  "areaId": "software-eng",
  "perspective": "operational",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "gap-scoring-matrix",
      "action-plan"
    ],
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "CVE database, NIST NVD, package security advisories"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "ecosystem",
      "type": "select",
      "label": "Package ecosystem",
      "required": true,
      "options": [
        {
          "value": "npm",
          "label": "npm / Node.js (package.json)"
        },
        {
          "value": "pip",
          "label": "pip / Python (requirements.txt, pyproject.toml)"
        },
        {
          "value": "maven",
          "label": "Maven / Java (pom.xml)"
        },
        {
          "value": "gradle",
          "label": "Gradle / Java or Kotlin (build.gradle)"
        },
        {
          "value": "nuget",
          "label": "NuGet / .NET (*.csproj, packages.config)"
        },
        {
          "value": "cargo",
          "label": "Cargo / Rust (Cargo.toml)"
        },
        {
          "value": "gem",
          "label": "RubyGems (Gemfile)"
        },
        {
          "value": "composer",
          "label": "Composer / PHP (composer.json)"
        },
        {
          "value": "go",
          "label": "Go modules (go.mod)"
        },
        {
          "value": "mixed",
          "label": "Multiple ecosystems"
        }
      ]
    },
    {
      "id": "dependency_list",
      "type": "textarea",
      "label": "Dependency list or audit output",
      "required": true,
      "placeholder": "Paste your package.json dependencies, requirements.txt, pom.xml dependencies, or the output of an audit tool (npm audit, pip-audit, Snyk, etc.).\n\nIf you have no audit tool output, paste the dependency list and I will assess known vulnerability patterns."
    },
    {
      "id": "system_context",
      "type": "textarea",
      "label": "System context",
      "placeholder": "e.g., Public-facing web application processing payment data, internal data pipeline (no external access), mobile SDK distributed to third parties, microservice in a PCI-DSS environment"
    },
    {
      "id": "license_policy",
      "type": "select",
      "label": "License compliance policy",
      "options": [
        {
          "value": "none",
          "label": "No specific policy — flag obvious risks"
        },
        {
          "value": "commercial",
          "label": "Commercial product — GPL/AGPL not permitted"
        },
        {
          "value": "strict",
          "label": "Strict: only permissive licenses (MIT, Apache, BSD)"
        },
        {
          "value": "open_source",
          "label": "Open source project — copyleft analysis needed"
        }
      ]
    },
    {
      "id": "last_audit",
      "type": "text",
      "label": "When was the last dependency audit?",
      "placeholder": "e.g., Never, 6 months ago, Q3 2024"
    }
  ],
  "recommendedPersonas": [
    "tech-expert"
  ],
  "tags": [
    "security",
    "dependencies",
    "cve",
    "supply-chain",
    "compliance",
    "vulnerability"
  ],
  "contentType": "plan_document"
}
