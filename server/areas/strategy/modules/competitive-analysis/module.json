{
  "formatVersion": "1.0",
  "id": "competitive-analysis",
  "label": "Competitive Intelligence & Benchmarking",
  "shortLabel": "Competitive Analysis",
  "icon": "Activity",
  "description": "Analyse the competitive landscape: competitor profiling, peer benchmarking, differentiation opportunities, and strategic positioning recommendations.",
  "color": "adv-gold",
  "areaId": "strategy",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "balanced",
    "outputFormats": [
      "detailed-findings",
      "decision-memo"
    ],
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "Financial services competitive landscape, Nordic market intelligence, product benchmarking"
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "analysis_focus",
      "type": "select",
      "label": "Competitive analysis focus",
      "required": true,
      "options": [
        {
          "value": "landscape",
          "label": "Full competitive landscape mapping"
        },
        {
          "value": "specific_competitor",
          "label": "Specific competitor deep dive"
        },
        {
          "value": "benchmarking",
          "label": "Peer benchmarking (products, pricing, capability)"
        },
        {
          "value": "positioning",
          "label": "Our differentiation and positioning"
        }
      ]
    },
    {
      "id": "competitor_names",
      "type": "textarea",
      "label": "Competitor name(s)",
      "description": "Name the competitors to profile. Leave blank for a landscape scan where the competitor set is itself part of the question.",
      "placeholder": "e.g. Deloitte Nordics, KPMG Sweden, two named boutiques"
    },
    {
      "id": "dimension",
      "type": "multi-select",
      "label": "Dimensions to analyse",
      "options": [
        {
          "value": "positioning",
          "label": "Positioning and messaging"
        },
        {
          "value": "product",
          "label": "Products and services"
        },
        {
          "value": "pricing",
          "label": "Pricing and commercial model"
        },
        {
          "value": "technology",
          "label": "Technology and digital"
        },
        {
          "value": "talent",
          "label": "Talent, key people and hiring signals"
        },
        {
          "value": "strategic_moves",
          "label": "Recent strategic moves (M&A, partnerships, launches)"
        },
        {
          "value": "client_wins",
          "label": "Client wins and losses"
        },
        {
          "value": "esg",
          "label": "ESG and sustainability positioning"
        },
        {
          "value": "regulatory",
          "label": "Regulatory posture"
        }
      ]
    },
    {
      "id": "strategic_question",
      "type": "textarea",
      "label": "Strategic question driving this analysis",
      "description": "What decision will this inform? Analysis without a decision behind it tends to be reported rather than used.",
      "placeholder": "e.g. Should we compete for Tier-1 bank DORA programmes, or concentrate on mid-market?"
    },
    {
      "id": "context",
      "type": "textarea",
      "label": "Context",
      "placeholder": "Describe your organisation, sector, and the competitive question this analysis will inform."
    }
  ],
  "recommendedPersonas": [
    "strategy-expert"
  ],
  "tags": [
    "competitive",
    "intelligence",
    "benchmarking",
    "strategy",
    "positioning"
  ],
  "contentType": "analytic_report"
}
