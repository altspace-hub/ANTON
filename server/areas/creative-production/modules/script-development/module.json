{
  "formatVersion": "1.0",
  "id": "script-development",
  "label": "Script & Screenplay Development",
  "shortLabel": "Script Dev",
  "icon": "Film",
  "description": "Develop screenplays, stage plays, teleplays, and game narratives with proper craft structure — beat sheets, character arcs, genre conventions, and professional formatting.",
  "color": "adv-teal",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "balanced",
    "outputFormats": [
      "detailed-findings"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Screenwriting craft, dramatic structure, genre conventions, formatting standards, character development, dialogue technique"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "format",
      "label": "Format",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "screenplay",
          "label": "Screenplay (Feature Film)"
        },
        {
          "value": "teleplay",
          "label": "Teleplay (TV Episode)"
        },
        {
          "value": "stage-play",
          "label": "Stage Play"
        },
        {
          "value": "short-film",
          "label": "Short Film Script"
        },
        {
          "value": "audio-drama",
          "label": "Audio Drama / Radio Play"
        },
        {
          "value": "game-narrative",
          "label": "Game Narrative / Interactive Story"
        },
        {
          "value": "web-series",
          "label": "Web Series Episode"
        }
      ]
    },
    {
      "id": "genre",
      "label": "Genre(s)",
      "type": "chips",
      "required": true,
      "options": [
        {
          "value": "drama",
          "label": "Drama"
        },
        {
          "value": "comedy",
          "label": "Comedy"
        },
        {
          "value": "thriller",
          "label": "Thriller"
        },
        {
          "value": "horror",
          "label": "Horror"
        },
        {
          "value": "sci-fi",
          "label": "Sci-Fi"
        },
        {
          "value": "fantasy",
          "label": "Fantasy"
        },
        {
          "value": "action",
          "label": "Action / Adventure"
        },
        {
          "value": "romance",
          "label": "Romance"
        },
        {
          "value": "documentary",
          "label": "Documentary"
        },
        {
          "value": "musical",
          "label": "Musical"
        },
        {
          "value": "comedy-drama",
          "label": "Comedy-Drama"
        },
        {
          "value": "crime",
          "label": "Crime / Noir"
        }
      ]
    },
    {
      "id": "stage",
      "label": "Development Stage",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "logline",
          "label": "Logline & Concept"
        },
        {
          "value": "treatment",
          "label": "Treatment (2-10 pages)"
        },
        {
          "value": "outline",
          "label": "Scene-by-Scene Outline"
        },
        {
          "value": "first-draft",
          "label": "First Draft Pages"
        },
        {
          "value": "revision",
          "label": "Revision & Notes"
        }
      ]
    },
    {
      "id": "structure",
      "label": "Story Structure",
      "type": "select",
      "required": false,
      "options": [
        {
          "value": "three-act",
          "label": "Three-Act Structure"
        },
        {
          "value": "five-act",
          "label": "Five-Act Structure"
        },
        {
          "value": "beat-sheet",
          "label": "Beat Sheet (Save the Cat)"
        },
        {
          "value": "episodic",
          "label": "Episodic / Anthology"
        },
        {
          "value": "non-linear",
          "label": "Non-linear"
        }
      ]
    },
    {
      "id": "tone_reference",
      "label": "Tone & Reference",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 'Like Fleabag meets The Favourite' or 'dark Scandinavian crime drama'"
    },
    {
      "id": "constraints",
      "label": "Practical Constraints",
      "type": "textarea",
      "required": false,
      "placeholder": "Cast size, location count, budget tier, running time target, language, any other constraints..."
    },
    {
      "id": "existing_material",
      "label": "Existing Material / Brief",
      "type": "textarea",
      "required": false,
      "placeholder": "Paste your logline, treatment, existing pages, character notes, or creative brief..."
    }
  ],
  "recommendedPersonas": [
    "creative-director"
  ],
  "tags": [
    "screenwriting",
    "playwriting",
    "screenplay",
