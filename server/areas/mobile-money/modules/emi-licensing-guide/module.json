      "required": true,
      "options": [
        {
          "value": "under-1m",
          "label": "<$1M"
        },
        {
          "value": "1m-5m",
          "label": "$1M–$5M"
        },
        {
          "value": "5m-20m",
          "label": "$5M–$20M"
        },
        {
          "value": "over-20m",
          "label": ">$20M"
        }
      ]
