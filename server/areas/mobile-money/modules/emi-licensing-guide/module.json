      "options": [
        {
          "value": "ke",
          "label": "Kenya"
        },
        {
          "value": "ng",
          "label": "Nigeria"
        },
        {
          "value": "gh",
          "label": "Ghana"
        },
        {
          "value": "tz",
          "label": "Tanzania"
        },
        {
          "value": "bd",
          "label": "Bangladesh"
        },
        {
          "value": "ph",
          "label": "Philippines"
        },
        {
          "value": "sg",
          "label": "Singapore"
        },
        {
          "value": "my",
          "label": "Malaysia"
        },
        {
          "value": "eu",
          "label": "EU (EMD2)"
        },
        {
          "value": "uk",
          "label": "UK (FCA)"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
