    {
      "id": "timeline",
      "type": "select",
      "label": "Target Timeline",
      "description": "When does the applicant need the licence?",
      "required": true,
      "options": [
        {
          "value": "asap",
          "label": "ASAP"
        },
        {
          "value": "3-6-months",
          "label": "3–6 months"
        },
        {
          "value": "6-12-months",
          "label": "6–12 months"
        },
        {
          "value": "planning-stage",
          "label": "Planning stage"
        }
