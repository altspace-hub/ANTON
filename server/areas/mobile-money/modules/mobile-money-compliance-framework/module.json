{
  "formatVersion": "1.0",
  "id": "mobile-money-compliance-framework",
  "label": "Mobile Money Compliance Framework",
  "shortLabel": "Compliance Framework",
  "description": "Comprehensive compliance framework for mobile money operators covering licensing, tiered KYC, AML/CFT obligations, agent oversight, and consumer protection requirements.",
  "perspective": "strategic",
  "icon": "Shield",
  "color": "adv-teal",
  "defaults": {
    "thinking": "investigate",
    "creativity": "strict",
    "outputFormats": [
      "gap-scoring-matrix",
      "policy-document",
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "GSMA Code of Conduct for Mobile Money Providers, FATF Recommendation 14 (MVTS), national central bank payment service provider frameworks, tiered KYC regulations"
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "operator_type",
      "type": "select",
      "label": "Operator Type",
      "description": "What type of mobile money operator are you assessing or advising?",
      "required": true,
      "options": [
        {
          "value": "mno",
          "label": "Mobile Network Operator (MNO)"
        },
        {
          "value": "bank-led",
          "label": "Bank-led MMO"
        },
        {
          "value": "fintech-mmo",
          "label": "Fintech MMO"
        },
        {
          "value": "agent-network-manager",
          "label": "Agent Network Manager"
        }
      ]
    },
    {
      "id": "jurisdiction",
      "type": "select",
      "label": "Primary Jurisdiction",
      "description": "Which country's regulatory framework is the primary reference?",
      "required": true,
      "options": [
        {
          "value": "ke",
          "label": "Kenya"
        },
        {
          "value": "ng",
          "label": "Nigeria"
        },
        {
          "value": "gh",
          "label": "Ghana"
        },
        {
          "value": "tz",
          "label": "Tanzania"
        },
        {
          "value": "ug",
          "label": "Uganda"
        },
        {
          "value": "bd",
          "label": "Bangladesh"
        },
        {
          "value": "pk",
          "label": "Pakistan"
        },
        {
          "value": "ph",
          "label": "Philippines"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "id": "services",
      "type": "chips",
      "label": "Active Services",
      "description": "Which services does the operator provide? Select all that apply.",
      "options": [
        {
          "value": "p2p",
          "label": "P2P transfers"
        },
        {
          "value": "bill-payments",
          "label": "Bill payments"
        },
        {
          "value": "merchant-payments",
          "label": "Merchant payments"
        },
        {
          "value": "savings-wallet",
          "label": "Savings (wallet)"
        },
        {
          "value": "loans",
          "label": "Loans"
        },
        {
          "value": "international-remittance",
          "label": "International remittance"
        }
      ]
    },
    {
      "id": "known_gaps",
      "type": "textarea",
      "label": "Known Compliance Gaps or Concerns",
      "description": "Describe any compliance weaknesses, regulatory findings, or areas of concern already identified.",
      "placeholder": "e.g. Agent KYC quality is inconsistent; transaction monitoring rules were last reviewed in 2021; no formal STR process documented for mobile money..."
    }
  ],
  "recommendedPersonas": [
    "mobile-money-agent-trainer",
    "mobile-money-compliance"
  ],
  "recommendedSkills": [
    "skill-gsma-mobile-money-aml",
    "jurisdiction-ke-cbk",
    "jurisdiction-ng-cbn"
  ],
  "tags": [
