{
  "formatVersion": "1.0",
  "id": "lean-six-sigma",
  "label": "Lean Six Sigma Analysis",
  "shortLabel": "Lean Six Sigma",
  "icon": "BarChart3",
  "description": "Apply Lean Six Sigma methodology to analyse manufacturing and operational problems. Covers DMAIC project framework, waste identification (8 wastes), statistical process control, root cause analysis, and solution design. Produces detailed findings reports and action plans structured around the DMAIC phases with data-driven recommendations.",
  "color": "adv-teal",
  "defaults": {
    "thinking": "investigate",
    "creativity": "balanced",
    "outputFormats": [
      "detailed-findings",
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Lean Six Sigma methodology, DMAIC, statistical process control, root cause analysis, value stream mapping, waste elimination, Kaizen"
      }
    }
  },
