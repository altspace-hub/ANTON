          "value": "iso-9001-2015",
          "label": "ISO 9001:2015"
        },
        {
          "value": "iatf-16949-automotive",
          "label": "IATF 16949 (automotive)"
        },
        {
          "value": "iso-13485-medical-devices",
          "label": "ISO 13485 (medical devices)"
        },
        {
          "value": "as9100-aerospace",
          "label": "AS9100 (aerospace)"
        },
        {
          "value": "iso-22000-food-safety",
          "label": "ISO 22000 (food safety)"
        },
        {
          "value": "gmp-pharmaceutical",
          "label": "GMP (pharmaceutical)"
        },
        {
          "value": "multiple-standards",
          "label": "Multiple standards"
        },
        {
          "value": "no-specific-standard-best-practice",
          "label": "No specific standard — best practice"
