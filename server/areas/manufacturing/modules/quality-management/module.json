          "label": "Quality policy and objectives"
        },
        {
          "value": "process-documentation",
          "label": "Process documentation"
        },
        {
          "value": "non-conformance-capa-procedures",
          "label": "Non-conformance/CAPA procedures"
        },
        {
          "value": "management-review-framework",
          "label": "Management review framework"
        },
        {
          "value": "internal-audit-programme",
          "label": "Internal audit programme"
        },
        {
          "value": "supplier-quality-management",
          "label": "Supplier quality management"
        },
        {
          "value": "pre-certification-gap-assessment",
          "label": "Pre-certification gap assessment"
