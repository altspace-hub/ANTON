        },
        {
          "value": "basic-qms-needs-significant-improvement",
          "label": "Basic QMS — needs significant improvement"
        },
        {
          "value": "established-qms-periodic-review",
          "label": "Established QMS — periodic review"
        },
        {
          "value": "mature-qms-optimisation-focus",
          "label": "Mature QMS — optimisation focus"
        },
        {
          "value": "transitioning-between-standards",
