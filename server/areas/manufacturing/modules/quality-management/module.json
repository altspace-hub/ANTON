{
  "formatVersion": "1.0",
  "id": "quality-management",
  "label": "Quality Management System",
  "shortLabel": "Quality Management",
  "icon": "CheckSquare",
  "description": "Develop, review, and improve Quality Management Systems (QMS) aligned with ISO 9001, industry-specific standards, and regulatory requirements. Covers quality policy development, process documentation, non-conformance management, corrective action procedures, and audit readiness. Produces structured policy documents and governance frameworks.",
  "color": "adv-teal",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "balanced",
    "outputFormats": [
      "policy-document"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "ISO 9001:2015, IATF 16949, ISO 13485, quality management principles, process approach, risk-based thinking, continuous improvement"
      }
    }
  },
  "guidedInputs": [
