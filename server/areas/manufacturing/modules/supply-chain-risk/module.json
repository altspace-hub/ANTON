{
  "formatVersion": "1.0",
  "id": "supply-chain-risk",
  "label": "Supply Chain Risk Assessment",
  "shortLabel": "Supply Chain Risk",
  "icon": "Network",
  "description": "Assess and mitigate risks across manufacturing supply chains. Covers supplier risk profiling, single-source dependency analysis, geopolitical risk assessment, logistics vulnerability mapping, and ESG supply chain compliance. Produces detailed findings reports and action plans with risk ratings, mitigation strategies, and monitoring frameworks.",
  "color": "adv-teal",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "balanced",
    "outputFormats": [
      "detailed-findings",
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "Supply chain risk management, supplier due diligence, geopolitical risk, ESG supply chain requirements, CSRD, supply chain resilience"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "industry",
      "label": "Industry",
      "type": "select",
      "options": [
