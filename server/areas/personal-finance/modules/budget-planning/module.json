{
  "formatVersion": "1.0",
  "id": "budget-planning",
  "label": "Budget Planning Assistant",
  "shortLabel": "Budget Planning",
  "icon": "Calculator",
  "description": "Create comprehensive personal or household budgets with structured income and expense analysis, savings targets, and spending optimisation recommendations. Produces actionable budget plans with categorised spending, priority-based allocation, and practical tips for financial improvement.",
  "color": "adv-green",
  "defaults": {
    "thinking": "think",
    "creativity": "balanced",
    "outputFormats": [
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Personal budgeting frameworks, household financial planning, expense categorisation, savings strategies"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "budget-type",
      "label": "Budget Type",
      "type": "select",
      "options": [
        {
          "value": "individual",
          "label": "Individual"
        },
        {
          "value": "couple-household",
          "label": "Couple/household"
        },
        {
          "value": "family-with-children",
          "label": "Family with children"
        },
        {
          "value": "student",
          "label": "Student"
        },
        {
          "value": "retiree",
          "label": "Retiree"
        }
      ],
      "required": true
    },
    {
      "id": "income-range",
      "label": "Monthly Net Income Range",
      "type": "select",
      "options": [
        {
          "value": "under-20-000-sek",
          "label": "Under 20,000 SEK"
        },
        {
          "value": "20-000-40-000-sek",
          "label": "20,000–40,000 SEK"
        },
        {
          "value": "40-000-60-000-sek",
          "label": "40,000–60,000 SEK"
        },
        {
          "value": "60-000-100-000-sek",
          "label": "60,000–100,000 SEK"
        },
        {
          "value": "over-100-000-sek",
          "label": "Over 100,000 SEK"
        },
        {
          "value": "prefer-not-to-specify",
          "label": "Prefer not to specify"
        }
      ],
      "required": false
    },
    {
      "id": "financial-goals",
      "label": "Financial Goals",
      "type": "multiselect",
      "options": [
        {
          "value": "emergency-fund",
          "label": "Emergency fund"
        },
        {
          "value": "debt-reduction",
          "label": "Debt reduction"
        },
        {
          "value": "home-purchase-savings",
          "label": "Home purchase savings"
        },
        {
          "value": "holiday-travel-fund",
          "label": "Holiday/travel fund"
        },
        {
          "value": "education-fund",
          "label": "Education fund"
        },
        {
          "value": "general-savings-increase",
          "label": "General savings increase"
        },
        {
          "value": "spending-reduction",
          "label": "Spending reduction"
        }
      ],
      "required": true
    },
    {
      "id": "current-challenges",
      "label": "Current Financial Challenges",
      "type": "textarea",
      "placeholder": "Describe any specific financial challenges or areas where you overspend...",
      "required": false
    }
  ],
  "recommendedPersonas": [
    "finance-expert"
  ],
  "tags": [
    "personal-finance",
    "budget",
    "planning",
    "savings",
    "spending"
  ]
}
