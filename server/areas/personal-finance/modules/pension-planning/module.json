{
  "formatVersion": "1.0",
  "id": "pension-planning",
  "label": "Pension & Retirement Planning",
  "shortLabel": "Pension Planning",
  "icon": "Calendar",
  "description": "Analyse pension arrangements and develop retirement planning strategies. Covers occupational pensions, private pension savings, state pension entitlements, and withdrawal strategies. Produces decision memos and action plans with projected retirement income, gap analysis, and optimisation recommendations across Nordic pension systems.",
  "color": "adv-green",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "balanced",
    "outputFormats": [
      "decision-memo",
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "Nordic pension systems, occupational pension schemes, private pension savings, state pension entitlements, retirement income planning, IORP II Directive"
      }
    }
  },
  "guidedInputs": [
