          "value": "sweden",
          "label": "Sweden"
        },
        {
          "value": "finland",
          "label": "Finland"
        },
        {
          "value": "denmark",
          "label": "Denmark"
        },
        {
          "value": "norway",
          "label": "Norway"
        },
        {
          "value": "uk",
          "label": "UK"
        },
        {
          "value": "germany",
          "label": "Germany"
        },
        {
          "value": "cross-border",
          "label": "Cross-border"
        }
      ],
      "required": true
