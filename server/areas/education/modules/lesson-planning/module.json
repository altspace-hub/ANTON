      "label": "Student age group",
      "required": true,
      "options": [
        {
          "value": "primary_lower",
          "label": "Primary (Ages 5-8)"
        },
        {
          "value": "primary_upper",
          "label": "Primary (Ages 9-11)"
        },
        {
          "value": "secondary_lower",
          "label": "Secondary (Ages 12-14)"
        },
        {
          "value": "secondary_upper",
          "label": "Secondary (Ages 15-18)"
        },
        {
          "value": "adult",
          "label": "Adult / Higher Education"
        },
        {
          "value": "professional",
          "label": "Professional Training"
        }
      ]
