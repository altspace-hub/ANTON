    {
      "id": "lesson_duration",
      "type": "select",
      "label": "Lesson duration",
      "options": [
        {
          "value": "30",
          "label": "30 minutes"
        },
        {
          "value": "45",
          "label": "45 minutes"
        },
        {
          "value": "60",
          "label": "60 minutes"
        },
        {
          "value": "90",
          "label": "90 minutes"
        },
        {
          "value": "series",
          "label": "Lesson series (multiple sessions)"
        }
      ]
