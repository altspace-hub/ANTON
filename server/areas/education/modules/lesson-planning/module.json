    {
      "id": "topic",
      "type": "textarea",
      "label": "Lesson topic and objectives",
      "required": true,
      "placeholder": "Describe the topic, key learning objectives, any curriculum requirements to align with, and any special considerations (SEN students, mixed ability, etc.)."
