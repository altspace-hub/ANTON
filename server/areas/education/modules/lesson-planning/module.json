      "label": "Subject area",
      "required": true,
      "options": [
        {
          "value": "mathematics",
          "label": "Mathematics"
        },
        {
          "value": "science",
          "label": "Science"
        },
        {
          "value": "languages",
          "label": "Languages / Literacy"
        },
        {
          "value": "social_studies",
          "label": "Social Studies / History"
        },
        {
          "value": "arts",
          "label": "Arts / Music / Drama"
        },
        {
          "value": "technology",
          "label": "Technology / Computing"
        },
        {
          "value": "pe",
          "label": "Physical Education"
        },
        {
          "value": "professional",
          "label": "Professional / Vocational"
        },
        {
          "value": "other",
          "label": "Other Subject"
        }
      ]
    },
    {
