      }
    }
  },
  "guidedInputs": [
    {
      "id": "curriculum_scope",
      "type": "select",
      "label": "Curriculum scope",
      "required": true,
      "options": [
        {
          "value": "single_course",
          "label": "Single Course / Module"
        },
        {
          "value": "semester",
          "label": "Semester Programme"
        },
        {
          "value": "year",
          "label": "Full Year Curriculum"
        },
        {
          "value": "programme",
          "label": "Multi-Year Programme"
        },
        {
          "value": "professional",
          "label": "Professional Certification Programme"
        }
      ]
    },
    {
      "id": "level",
      "type": "select",
      "label": "Educational level",
      "required": true,
      "options": [
        {
          "value": "primary",
          "label": "Primary Education"
        },
        {
          "value": "secondary",
          "label": "Secondary Education"
        },
        {
          "value": "higher",
          "label": "Higher Education / University"
        },
        {
          "value": "professional",
          "label": "Professional / Corporate Training"
        },
        {
          "value": "continuing",
          "label": "Continuing Education"
        }
      ]
    },
    {
      "id": "subject_area",
      "type": "textarea",
      "label": "Subject and learning outcomes",
      "required": true,
      "placeholder": "Describe the subject area, target competencies, any national curriculum standards to align with, and desired learning outcomes."
    }
  ],
  "recommendedPersonas": [
    "education-expert"
