{
  "formatVersion": "1.0",
  "id": "financial-analysis",
  "label": "Financial Analysis & Modelling",
  "shortLabel": "Financial Analysis",
  "icon": "Calculator",
  "description": "Analyse financial statements, build model narratives, stress-test assumptions, and identify value drivers. Covers VC unit economics, PE quality of earnings, LBO analysis, and DCF.",
  "color": "adv-blue",
  "modelTier": {
    "recommended": "opus",
    "minimum": "sonnet",
    "professional": "opus",
    "notes": "Accuracy critical for financial analysis. Opus 4.7 default."
  },
  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "detailed-findings",
      "maturity-assessment"
    ],
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Financial modelling, valuation, unit economics, LBO analysis"
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "analysis_type",
      "type": "select",
      "label": "What analysis do you need?",
      "required": true,
      "options": [
        {
          "value": "unit-economics",
          "label": "Unit economics breakdown (VC)"
        },
        {
          "value": "revenue-model",
          "label": "Revenue model analysis and projections"
        },
        {
          "value": "quality-of-earnings",
          "label": "Quality of earnings analysis (PE)"
        },
        {
          "value": "working-capital",
          "label": "Working capital and cash flow analysis"
        },
        {
          "value": "lbo-returns",
          "label": "LBO returns analysis (PE buyout)"
        },
        {
          "value": "comparable-analysis",
          "label": "Comparable company / transaction analysis"
        },
        {
          "value": "sensitivity",
          "label": "Sensitivity analysis (what breaks the model?)"
        },
        {
          "value": "red-flags",
          "label": "Financial statement red flags"
        },
        {
          "value": "mgmt-vs-our-case",
          "label": "Management case vs. our case comparison"
        }
      ]
    },
    {
      "id": "financials_provided",
      "type": "select",
      "label": "What financial data do you have?",
      "required": true,
      "options": [
        {
          "value": "full",
          "label": "Full P&L and balance sheet"
        },
        {
          "value": "summary",
          "label": "Summary financials / deck"
        },
        {
          "value": "metrics-only",
          "label": "Key metrics only (ARR, growth, margins)"
        },
        {
          "value": "nothing",
          "label": "Nothing yet — help me structure what to ask for"
        }
      ]
    },
    {
      "id": "financial_data",
      "type": "textarea",
      "label": "Paste or describe the key numbers",
      "placeholder": "Revenue: €5M (2023), €8M (2024). Gross margin: 72%. Net retention: 118%. Burn: €400K/month...",
      "required": false
    },
    {
      "id": "investment_style",
      "type": "select",
      "label": "Investment type",
      "required": true,
      "options": [
        {
          "value": "vc-early",
          "label": "VC Early"
        },
        {
          "value": "vc-growth",
          "label": "VC Growth"
        },
        {
          "value": "pe-growth",
          "label": "PE Growth"
        },
        {
          "value": "pe-buyout",
          "label": "PE Buyout"
        }
      ]
    }
  ],
  "tags": [
    "pe-vc",
    "financial-analysis",
    "unit-economics",
    "lbo",
    "quality-of-earnings",
    "dcf",
    "modelling"
