{
  "formatVersion": "1.0",
  "id": "deal-structure",
  "label": "Term Sheet & Deal Structure Advisor",
  "shortLabel": "Deal Structure",
  "icon": "Handshake",
  "description": "Analyse, draft, and negotiate term sheets and deal structures. Covers liquidation preferences, anti-dilution, board rights, drag-along, earn-outs, and return implications.",
  "color": "adv-blue",
  "modelTier": {
    "recommended": "opus",
    "minimum": "sonnet",
    "professional": "opus",
    "notes": "Opus 4.7 for complex term sheet analysis. Legal review always required before execution."
  },
  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "detailed-findings",
      "decision-memo"
    ],
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "VC/PE term sheet terms, deal structures, return waterfalls, legal frameworks"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "task",
      "type": "select",
      "label": "What do you need?",
      "required": true,
      "options": [
        {
          "value": "analyse-term-sheet",
          "label": "Analyse a term sheet I received"
        },
        {
          "value": "draft-term-sheet",
          "label": "Draft a term sheet (I'm the investor)"
        },
        {
          "value": "compare-term-sheets",
          "label": "Compare two competing term sheets"
        },
        {
          "value": "explain-terms",
          "label": "Explain specific terms and their implications"
        },
        {
          "value": "model-returns",
          "label": "Model the impact of terms on returns"
        },
        {
          "value": "negotiate",
          "label": "Negotiate — suggest counter-proposals"
        }
      ]
    },
    {
      "id": "deal_type",
      "type": "select",
      "label": "Deal type",
      "required": true,
      "options": [
        {
          "value": "vc-equity",
          "label": "VC equity round"
        },
        {
          "value": "convertible",
          "label": "Convertible note / SAFE"
        },
        {
          "value": "growth-equity",
          "label": "Growth equity"
        },
        {
          "value": "pe-buyout",
          "label": "PE majority buyout"
        },
        {
          "value": "pe-minority",
          "label": "PE minority investment"
        },
        {
          "value": "secondary",
          "label": "Secondary transaction"
        }
      ]
    },
    {
      "id": "term_sheet_text",
      "type": "textarea",
      "label": "Paste the term sheet or key terms",
      "placeholder": "Pre-money valuation: €40M\nInvestment amount: €8M\nPre-money cap table: Founders 60%, Existing VCs 30%, Option pool 10%\nLiquidation preference: 1x non-participating\nAnti-dilution: Broad-based weighted average\nBoard seats: 1 investor seat (out of 5)",
      "required": false
    },
    {
      "id": "your_position",
      "type": "select",
      "label": "Your role",
      "required": true,
      "options": [
        {
          "value": "investor",
          "label": "Investor (buying)"
        },
        {
          "value": "company",
          "label": "Company / founder (selling)"
        },
        {
          "value": "advisor",
          "label": "Advisor / co-investor"
        }
      ]
    }
  ],
  "tags": [
    "pe-vc",
    "term-sheet",
    "deal-structure",
    "liquidation-preference",
    "anti-dilution",
    "negotiation"
  ],
  "recommendedPersonas": [
    "pe-vc-expert"
  ]
}
