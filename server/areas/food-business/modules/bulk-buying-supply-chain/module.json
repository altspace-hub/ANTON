{
  "formatVersion": "1.0",
  "id": "bulk-buying-supply-chain",
  "label": "Bulk Buying & Supply Chain",
  "shortLabel": "Bulk Buying",
  "icon": "Truck",
  "description": "Source ingredients cheaper. Bulk buying, supplier relationships, and avoiding shortages.",
  "color": "adv-teal",
  "modelTier": {
    "recommended": "haiku",
    "minimum": "ollama-local",
    "professional": "sonnet",
    "notes": "Short practical responses work well with smaller models."
  },
  "defaults": {
    "thinking": "think",
    "creativity": "balanced",
    "outputFormats": ["quick-briefing"],
    "transparencyLevel": 0,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Bulk buying strategies, wholesale sourcing, and supply chain management for micro-food-businesses in developing countries"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "business_type",
      "type": "select",
      "label": "What kind of food business do you have?",
      "required": true,
      "options": [
        { "value": "street-stall", "label": "Street food stall" },
        { "value": "small-restaurant", "label": "Small restaurant" },
        { "value": "catering", "label": "Catering" },
        { "value": "home-based", "label": "Home-based food business" },
        { "value": "market-vendor", "label": "Market food vendor" }
      ]
    },
    {
      "id": "main_ingredients",
      "type": "text",
      "label": "What are your most expensive ingredients?",
      "placeholder": "e.g. cooking oil, flour, tomatoes, chicken",
      "required": false
    },
    {
      "id": "buying_frequency",
      "type": "select",
      "label": "How often do you currently buy ingredients?",
      "required": true,
      "options": [
        { "value": "daily", "label": "Daily" },
        { "value": "weekly", "label": "Weekly" },
        { "value": "as-needed", "label": "When I run out" },
        { "value": "monthly", "label": "Monthly" }
      ]
    },
    {
      "id": "challenge",
      "type": "select",
      "label": "What is your main supply challenge?",
      "required": true,
      "options": [
        { "value": "prices-rising", "label": "Ingredient prices keep going up" },
        { "value": "supply-runs-out", "label": "Supply runs out when I need it" },
        { "value": "quality-varies", "label": "Quality varies between purchases" },
        { "value": "want-cheaper", "label": "I don't know where to buy cheaper" }
      ]
    }
  ],
  "recommendedPersonas": ["small-business-mentor", "food-safety-inspector"],
  "tags": [
    "bop",
    "food-business",
    "bulk-buying",
    "supply-chain",
    "wholesale",
    "ingredients",
    "food-vendor",
    "collective-purchasing"
  ]
}
