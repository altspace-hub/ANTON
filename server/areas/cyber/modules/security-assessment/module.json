{
  "formatVersion": "1.0",
  "id": "security-assessment",
  "label": "Information Security Assessment",
  "shortLabel": "Security Assessment",
  "icon": "ScanSearch",
  "description": "Assess information security maturity against ISO 27001, NIST CSF, and sector-specific requirements. Identify control gaps, prioritise remediation, and produce a security improvement roadmap.",
  "color": "adv-red",
  "areaId": "cyber",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "maturity-assessment",
      "gap-scoring-matrix"
    ],
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "ISO 27001:2022, NIST CSF 2.0, EBA ICT guidelines"
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "assessment_framework",
      "type": "multi-select",
      "label": "Assessment framework(s) to use",
      "options": [
        {
          "value": "iso27001",
          "label": "ISO 27001:2022 / ISO 27002:2022"
        },
        {
          "value": "nist_csf",
          "label": "NIST Cybersecurity Framework 2.0"
        },
        {
          "value": "eba_ict",
          "label": "EBA ICT & Security Risk Guidelines (EBA/GL/2019/04)"
        },
        {
          "value": "nist_800_53",
          "label": "NIST SP 800-53"
        },
        {
          "value": "cis_controls",
          "label": "CIS Controls v8"
        }
      ]
    },
    {
      "id": "assessment_domains",
      "type": "multi-select",
      "label": "Security domains to assess",
      "options": [
        {
          "value": "governance",
          "label": "Governance & Risk Management"
        },
        {
          "value": "access_control",
          "label": "Identity & Access Management"
        },
        {
          "value": "asset_management",
          "label": "Asset & Configuration Management"
        },
        {
          "value": "vulnerability",
          "label": "Vulnerability Management & Patching"
        },
        {
          "value": "network",
          "label": "Network Security & Segmentation"
        },
        {
          "value": "endpoint",
          "label": "Endpoint Protection"
        },
        {
          "value": "cloud",
          "label": "Cloud Security"
        },
        {
          "value": "data_protection",
          "label": "Data Protection & Encryption"
        },
        {
          "value": "incident",
          "label": "Incident Detection & Response"
        },
        {
          "value": "bcdr",
          "label": "Business Continuity & Disaster Recovery"
        },
        {
          "value": "supply_chain",
          "label": "Supplier & Third-Party Security"
        },
        {
          "value": "awareness",
          "label": "Security Awareness & Training"
        }
      ]
    },
    {
      "id": "organisation_context",
      "type": "textarea",
      "label": "Organisation context",
      "placeholder": "e.g., Mid-sized bank, 2000 employees, heavily cloud-based (Azure), no dedicated SOC, last penetration test 18 months ago."
    }
  ],
  "recommendedPersonas": [
    "auditor",
    "devil-advocate"
  ],
  "tags": [
    "iso27001",
    "nist",
    "security",
    "cyber",
    "assessment",
    "maturity"
  ]
}
