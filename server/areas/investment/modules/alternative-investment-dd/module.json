    {
      "id": "investment_thesis",
      "type": "textarea",
      "label": "Investment thesis or context",
      "placeholder": "e.g., buyout of mid-market industrials, European focus. GP is raising Fund IV after strong Fund III performance. Considering €25M commitment."
    }
