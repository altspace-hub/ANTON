        {
          "value": "operations",
          "label": "Operations"
        },
        {
          "value": "team",
          "label": "Team"
        },
        {
          "value": "compliance",
          "label": "Compliance"
        },
        {
          "value": "fees",
          "label": "Fees"
        },
        {
          "value": "liquidity",
          "label": "Liquidity"
        }
      ]
    }
