{
  "formatVersion": "1.0",
  "id": "portfolio-review",
  "label": "Portfolio Review & Reporting",
  "shortLabel": "Portfolio Review",
  "icon": "PieChart",
  "description": "Review portfolio performance, risk attribution, concentration, liquidity, regulatory limits, and ESG alignment.",
  "color": "adv-gold",
  "areaId": "investment",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "balanced",
    "outputFormats": [
      "detailed-findings",
      "executive-summary"
    ],
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Portfolio management, risk attribution, MiFID reporting, UCITS limits"
