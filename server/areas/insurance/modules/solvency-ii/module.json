  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "gap-scoring-matrix",
      "detailed-findings"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "Solvency II Directive 2009/138/EC, Delegated Regulation 2015/35, EIOPA guidelines and technical standards, ORSA requirements"
      }
    }
  },
