{
  "formatVersion": "1.0",
  "id": "reinsurance-program-review",
  "label": "Reinsurance Program Review",
  "shortLabel": "Reinsurance Review",
  "icon": "Network",
  "description": "Evaluate reinsurance program structures for adequacy, efficiency, and strategic alignment. Covers proportional and non-proportional treaty design, facultative placements, reinsurer credit quality, pricing adequacy, aggregate protection, IFRS 17 impact on reinsurance held, and retakaful for Islamic insurers.",
  "color": "adv-blue",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "detailed-findings",
      "decision-memo"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Reinsurance program design, treaty and facultative structures, reinsurer rating methodologies, IFRS 17 reinsurance held requirements"
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "entity_type",
      "type": "select",
      "label": "Cedant / Entity Type",
      "required": true,
      "options": [
        {
          "value": "primary-insurer",
          "label": "Primary insurer"
        },
        {
          "value": "lloyd-s-managing-agency",
          "label": "Lloyd's managing agency"
        },
        {
          "value": "captive-insurer",
          "label": "Captive insurer"
        },
        {
          "value": "takaful-operator",
          "label": "Takaful operator"
        }
      ]
    },
    {
      "id": "lines_of_business",
      "type": "multiselect",
      "label": "Lines of Business",
      "options": [
        {
          "value": "property-cat",
          "label": "Property CAT"
        },
        {
          "value": "property-per-risk",
          "label": "Property per risk"
        },
        {
          "value": "casualty-liability",
          "label": "Casualty / liability"
        },
        {
          "value": "marine-and-cargo",
          "label": "Marine and cargo"
        },
        {
          "value": "life-and-health",
          "label": "Life and health"
        },
        {
          "value": "financial-lines-d-o-cyber",
          "label": "Financial lines (D&O, cyber)"
        },
        {
          "value": "specialty-and-aviation",
          "label": "Specialty and aviation"
        }
      ]
    },
    {
      "id": "review_purpose",
      "type": "select",
      "label": "Purpose of Review",
      "required": true,
      "options": [
        {
          "value": "annual-renewal-adequacy-review",
          "label": "Annual renewal — adequacy review"
        },
        {
          "value": "post-loss-review",
          "label": "Post-loss review"
        },
        {
          "value": "new-line-of-business-program-design",
          "label": "New line of business — program design"
        },
        {
          "value": "rating-agency-or-capital-model-requirement",
          "label": "Rating agency or capital model requirement"
        },
        {
          "value": "capital-optimisation-exercise",
          "label": "Capital optimisation exercise"
        }
      ]
    },
    {
      "id": "concerns",
      "type": "textarea",
      "label": "Specific Concerns or Context",
      "placeholder": "e.g. Recent large loss testing aggregate limits, new CAT model output suggests under-protection, rating agency pushing for higher reinsurer credit quality...",
      "required": false
    }
  ],
  "recommendedPersonas": [
    "finance-expert",
    "risk-specialist"
  ],
  "tags": [
    "reinsurance",
    "insurance",
    "program-design",
    "treaty",
    "capital-management",
    "ifrs17"
  ]
}
