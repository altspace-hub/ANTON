{
  "formatVersion": "1.0",
  "id": "idd-compliance",
  "label": "IDD Compliance",
  "shortLabel": "IDD Compliance",
  "icon": "FileCheck",
  "description": "Assess compliance with the Insurance Distribution Directive (IDD) requirements. Covers conduct of business rules, demands and needs analysis, suitability and appropriateness testing, inducements and conflicts of interest, cross-selling, and information disclosure requirements for insurance distributors.",
  "color": "adv-blue",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "gap-scoring-matrix"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "Insurance Distribution Directive 2016/97/EU, IDD Delegated Regulations, EIOPA technical advice, national transposition measures"
      }
    }
  },
