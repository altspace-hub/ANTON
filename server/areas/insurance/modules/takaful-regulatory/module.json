{
  "formatVersion": "1.0",
  "id": "takaful-regulatory",
  "label": "Takaful Regulatory Compliance",
  "shortLabel": "Takaful Compliance",
  "icon": "Shield",
  "description": "Assess regulatory compliance for Takaful operators against applicable prudential and Sharia governance standards. Covers IFSB-8 solvency requirements, AAOIFI governance standards, fund segregation, Sharia Supervisory Board requirements, and key jurisdictional frameworks including SAMA, BNM, and CBUAE.",
  "color": "adv-blue",
  "defaults": {
    "thinking": "think",
    "creativity": "strict",
    "outputFormats": [
      "gap-scoring-matrix",
      "policy-document"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "IFSB-8 Takaful governance standards, AAOIFI FAS 12 and governance standards, SAMA Cooperative Insurance Law, BNM Takaful Operational Framework"
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "jurisdiction",
      "type": "select",
      "label": "Jurisdiction / Regulator",
      "required": true,
      "options": [
        {
          "value": "saudi-arabia-sama",
          "label": "Saudi Arabia (SAMA)"
        },
        {
          "value": "uae-ia-cbuae",
          "label": "UAE (IA / CBUAE)"
        },
        {
          "value": "malaysia-bnm",
          "label": "Malaysia (BNM)"
        },
        {
          "value": "pakistan-secp",
          "label": "Pakistan (SECP)"
        },
        {
          "value": "bahrain-cbb",
          "label": "Bahrain (CBB)"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "id": "entity_type",
      "type": "select",
      "label": "Entity Type",
      "required": true,
      "options": [
        {
          "value": "standalone-takaful-operator",
          "label": "Standalone Takaful operator"
        },
        {
          "value": "retakaful-operator",
          "label": "Retakaful operator"
        },
        {
          "value": "islamic-window-within-conventional-insurer",
          "label": "Islamic window within conventional insurer"
        },
        {
          "value": "family-and-general-composite-takaful",
          "label": "Family and General composite Takaful"
        }
      ]
    },
    {
      "id": "compliance_focus",
      "type": "multiselect",
      "label": "Compliance Focus Areas",
      "options": [
        {
          "value": "solvency-margins-and-capital-requirements",
          "label": "Solvency margins and capital requirements"
        },
        {
          "value": "sharia-governance-and-ssb-requirements",
          "label": "Sharia governance and SSB requirements"
        },
        {
          "value": "participant-fund-management-and-segregation",
          "label": "Participant fund management and segregation"
        },
        {
          "value": "disclosure-and-reporting-obligations",
          "label": "Disclosure and reporting obligations"
        },
        {
          "value": "investment-restrictions-and-compliance",
          "label": "Investment restrictions and compliance"
        },
        {
          "value": "surplus-distribution-policy",
          "label": "Surplus distribution policy"
        }
      ]
    },
    {
      "id": "concerns",
      "type": "textarea",
      "label": "Known Concerns or Supervisory Findings",
      "placeholder": "Describe any known gaps, supervisory feedback, or areas of concern...",
      "required": false
    }
  ],
  "recommendedPersonas": [
    "finance-expert",
    "risk-specialist"
  ],
  "tags": [
    "takaful",
    "regulatory",
    "islamic-finance",
    "sharia-governance",
    "ifsb",
    "aaoifi"
  ]
}
