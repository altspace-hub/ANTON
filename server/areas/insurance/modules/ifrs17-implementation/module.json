{
  "formatVersion": "1.0",
  "id": "ifrs17-implementation",
  "label": "IFRS 17 Implementation Guide",
  "shortLabel": "IFRS 17",
  "icon": "BookOpen",
  "description": "Guidance on implementing IFRS 17 Insurance Contracts — measurement models (GMM, PAA, VFA), transition approaches, disclosure requirements, and impact on P&L and equity. Supports insurers at every stage from impact assessment through post-go-live refinement.",
  "color": "adv-teal",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "detailed-findings",
      "gap-scoring-matrix",
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": ""
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "entity_type",
      "type": "select",
      "label": "Entity Type",
      "required": true,
      "options": [
        "Life Insurance",
        "Non-Life / P&C Insurance",
        "Composite Insurer",
        "Reinsurer",
        "Takaful Operator"
      ]
    },
    {
      "id": "measurement_model",
      "type": "multiselect",
      "label": "Applicable Measurement Models",
      "options": [
        "General Measurement Model (GMM/BBA)",
        "Premium Allocation Approach (PAA)",
        "Variable Fee Approach (VFA)"
      ]
    },
    {
      "id": "stage",
      "type": "select",
      "label": "Implementation Stage",
      "options": [
        "Impact assessment",
        "Solution design",
        "Build & test",
        "Parallel run",
        "Post go-live / refinement"
      ]
    },
    {
      "id": "concerns",
      "type": "textarea",
      "label": "Specific Concerns",
      "placeholder": "e.g. CSM calculation, transition to modified retrospective, data gaps, reinsurance held...",
      "required": false
    }
  ],
  "recommendedPersonas": [
    "finance-expert",
    "risk-specialist"
  ],
  "tags": [
    "ifrs17",
    "insurance",
    "accounting",
    "actuarial"
  ]
}
