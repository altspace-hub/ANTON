{
  "formatVersion": "1.0",
  "id": "ifrs17-implementation",
  "label": "IFRS 17 Implementation Guide",
  "shortLabel": "IFRS 17",
  "icon": "BookOpen",
  "description": "Guidance on implementing IFRS 17 Insurance Contracts — measurement models (GMM, PAA, VFA), transition approaches, disclosure requirements, and impact on P&L and equity. Supports insurers at every stage from impact assessment through post-go-live refinement.",
  "color": "adv-teal",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "detailed-findings",
      "gap-scoring-matrix",
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": ""
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "entity_type",
      "type": "select",
      "label": "Entity Type",
      "required": true,
      "options": [
        {
          "value": "life-insurance",
          "label": "Life Insurance"
        },
        {
          "value": "non-life-p-c-insurance",
          "label": "Non-Life / P&C Insurance"
        },
        {
          "value": "composite-insurer",
          "label": "Composite Insurer"
        },
        {
          "value": "reinsurer",
          "label": "Reinsurer"
        },
        {
          "value": "takaful-operator",
          "label": "Takaful Operator"
        }
      ]
    },
    {
      "id": "measurement_model",
      "type": "multiselect",
      "label": "Applicable Measurement Models",
      "options": [
        {
          "value": "general-measurement-model-gmm-bba",
          "label": "General Measurement Model (GMM/BBA)"
        },
        {
          "value": "premium-allocation-approach-paa",
          "label": "Premium Allocation Approach (PAA)"
        },
        {
          "value": "variable-fee-approach-vfa",
          "label": "Variable Fee Approach (VFA)"
        }
      ]
    },
    {
      "id": "stage",
      "type": "select",
      "label": "Implementation Stage",
      "options": [
        {
          "value": "impact-assessment",
          "label": "Impact assessment"
        },
        {
          "value": "solution-design",
          "label": "Solution design"
        },
        {
          "value": "build-test",
          "label": "Build & test"
        },
        {
          "value": "parallel-run",
          "label": "Parallel run"
        },
        {
          "value": "post-go-live-refinement",
          "label": "Post go-live / refinement"
