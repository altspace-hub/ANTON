{
  "formatVersion": "1.0",
  "id": "branding-storytelling",
  "label": "Branding & Storytelling for Artisans",
  "shortLabel": "Tell Your Story",
  "icon": "Star",
  "description": "Tell your story to sell more. How your background, tradition, and technique become your most powerful marketing tool.",
  "color": "adv-teal",
  "modelTier": {
    "recommended": "haiku",
    "minimum": "ollama-local",
    "professional": "sonnet",
    "notes": "Short practical responses work well with smaller models."
  },
  "defaults": {
    "thinking": "think",
    "creativity": "balanced",
    "outputFormats": ["quick-briefing"],
    "transparencyLevel": 0,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Artisan branding, provenance storytelling, marketing for handmade crafts, artisan identity and cultural heritage as competitive advantage"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "craft_type",
      "type": "select",
      "label": "What type of craft do you make?",
      "required": true,
      "options": [
        { "value": "weaving-fabric", "label": "Weaving or fabric" },
        { "value": "pottery", "label": "Pottery" },
        { "value": "jewellery", "label": "Jewellery" },
        { "value": "woodwork", "label": "Woodwork" },
        { "value": "leather", "label": "Leather goods" },
        { "value": "beadwork", "label": "Beadwork" },
        { "value": "basketry", "label": "Basketry" },
        { "value": "embroidery", "label": "Embroidery" },
        { "value": "other", "label": "Other" }
      ]
    },
    {
      "id": "tradition",
      "type": "text",
      "label": "Briefly describe your craft tradition",
      "placeholder": "e.g. Maasai beadwork passed down from my grandmother, 40 years in our community",
      "required": false
    },
    {
      "id": "current_marketing",
      "type": "select",
      "label": "How do you currently market your work?",
      "required": true,
      "options": [
        { "value": "none", "label": "No marketing — buyers come to me or I sell at market" },
        { "value": "word-of-mouth", "label": "Word of mouth only" },
        { "value": "social-media", "label": "Some social media" },
        { "value": "ngo-cooperative", "label": "Through an NGO or cooperative" },
        { "value": "all", "label": "All of the above" }
      ]
    }
  ],
  "recommendedPersonas": ["small-business-mentor", "cooperative-development-officer", "womens-empowerment-advisor"],
  "tags": [
    "bop",
    "artisan",
    "craft",
    "branding",
    "storytelling",
    "marketing",
    "provenance",
    "cultural-heritage",
    "handmade",
    "womens-economic-empowerment"
  ]
}
