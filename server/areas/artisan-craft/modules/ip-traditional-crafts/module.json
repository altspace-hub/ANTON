{
  "formatVersion": "1.0",
  "id": "ip-traditional-crafts",
  "label": "Intellectual Property for Traditional Crafts",
  "shortLabel": "Protect Your Designs",
  "icon": "Shield",
  "description": "Protect your traditional designs. Know your rights when your patterns, designs, or craft techniques are copied.",
  "color": "adv-teal",
  "modelTier": {
    "recommended": "haiku",
    "minimum": "ollama-local",
    "professional": "sonnet",
    "notes": "Short practical responses work well with smaller models. Use sonnet for complex IP questions."
  },
  "defaults": {
    "thinking": "think",
    "creativity": "balanced",
    "outputFormats": [
      "quick-briefing"
    ],
    "transparencyLevel": 0,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Intellectual property protection for artisans — copyright, trade marks, geographical indications, traditional knowledge protection, WIPO resources for developing country artisans"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "craft_type",
      "type": "select",
      "label": "What type of craft do you make?",
      "required": true,
      "options": [
        {
          "value": "weaving-fabric",
          "label": "Weaving or fabric"
        },
        {
          "value": "pottery",
          "label": "Pottery"
        },
        {
          "value": "jewellery",
          "label": "Jewellery"
        },
        {
          "value": "woodwork",
          "label": "Woodwork"
        },
        {
          "value": "leather",
          "label": "Leather goods"
        },
        {
          "value": "beadwork",
          "label": "Beadwork"
        },
        {
          "value": "basketry",
          "label": "Basketry"
        },
        {
          "value": "embroidery",
          "label": "Embroidery"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "id": "country",
      "type": "select",
      "label": "Which country are you in?",
      "required": true,
      "options": [
        {
          "value": "kenya",
          "label": "Kenya"
        },
        {
          "value": "nigeria",
          "label": "Nigeria"
        },
        {
          "value": "ghana",
          "label": "Ghana"
        },
        {
          "value": "tanzania",
          "label": "Tanzania"
        },
        {
          "value": "south-africa",
          "label": "South Africa"
        },
        {
          "value": "india",
          "label": "India"
        },
        {
          "value": "bangladesh",
          "label": "Bangladesh"
        },
        {
          "value": "pakistan",
          "label": "Pakistan"
        },
        {
          "value": "indonesia",
          "label": "Indonesia"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "id": "ip_concern",
      "type": "select",
      "label": "What is your main IP concern?",
      "required": true,
      "options": [
        {
          "value": "design-copied",
          "label": "My design was copied by another seller"
        },
        {
          "value": "fake-versions",
          "label": "Someone is selling fake or poor imitations of my work"
        },
        {
          "value": "want-to-protect",
          "label": "I want to protect my designs before selling more widely"
        },
        {
          "value": "community-design",
          "label": "Traditional community design is being used without permission"
        }
      ]
    },
    {
      "id": "situation",
      "type": "select",
      "label": "Are you acting as an individual or for a community?",
      "required": true,
      "options": [
        {
          "value": "individual",
          "label": "Individual artisan"
        },
        {
          "value": "cooperative",
          "label": "Cooperative or artisan group"
        },
        {
          "value": "community",
          "label": "Community or ethnic group with shared traditional design"
        }
      ]
    }
  ],
  "recommendedPersonas": [
