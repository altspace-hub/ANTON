{
  "formatVersion": "1.0",
  "id": "crypto-aml-cft",
  "label": "Crypto AML/CFT & Travel Rule",
  "shortLabel": "Crypto AML",
  "icon": "ShieldAlert",
  "description": "AML/CFT compliance for CASPs and VASPs: EBA Guidelines on crypto ML/TF risks, EU Travel Rule (TFR 2023/1113), FATF Recommendation 15 & VA Guidance, KYC/CDD for crypto clients, transaction monitoring calibration for crypto typologies, and sanctions screening including OFAC wallet address lists.",
  "color": "adv-teal",
  "modelTier": {
    "recommended": "opus",
    "minimum": "sonnet",
    "professional": "opus",
    "notes": "AML compliance errors carry criminal liability. Opus 4.7 mandatory for gap assessments and policy work."
  },
  "defaults": {
    "thinking": "investigate",
    "creativity": "strict",
    "outputFormats": [
      "gap-scoring-matrix",
      "policy-document",
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "EBA crypto AML guidelines, TFR 2023/1113, FATF R15 and VA guidance, FATF grey/black lists (current)"
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
