{
  "formatVersion": "1.0",
  "id": "patient-safety-quality",
  "label": "Patient Safety & Quality Assessment",
  "shortLabel": "Patient Safety",
  "icon": "Heart",
  "description": "Assess patient safety programs, clinical quality indicators, serious adverse event processes, root cause analysis, and accreditation readiness (JCI, ISO 15189, CQC).",
  "color": "adv-teal",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "strict",
    "outputFormats": [
      "gap-scoring-matrix",
      "detailed-findings",
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "WHO patient safety goals, JCI International Patient Safety Goals, RCA methodology, FMEA in healthcare, Just Culture framework, clinical quality indicators, accreditation standards"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "organisation_type",
      "label": "Organisation Type",
      "type": "select",
      "options": [
        {
          "value": "hospital",
          "label": "Hospital"
        },
        {
          "value": "clinic",
          "label": "Clinic"
        },
        {
          "value": "diagnostic-lab",
          "label": "Diagnostic lab"
        },
        {
          "value": "pharmaceutical-manufacturer",
          "label": "Pharmaceutical manufacturer"
        },
        {
          "value": "medical-device-company",
          "label": "Medical device company"
        },
        {
          "value": "home-care",
          "label": "Home care"
        }
      ],
      "required": true
    },
    {
      "id": "accreditation",
      "label": "Accreditation Target",
      "type": "select",
      "options": [
        {
          "value": "jci",
          "label": "JCI"
        },
        {
          "value": "iso-15189",
          "label": "ISO 15189"
        },
        {
          "value": "cqc-uk",
          "label": "CQC (UK)"
        },
        {
          "value": "t-v",
          "label": "TÜV"
        },
        {
          "value": "national-accreditation",
          "label": "National accreditation"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "required": true
    },
    {
      "id": "focus",
      "label": "Safety Focus Areas",
      "type": "multiselect",
      "options": [
        {
          "value": "serious-adverse-events",
          "label": "Serious adverse events"
        },
        {
          "value": "medication-errors",
          "label": "Medication errors"
        },
        {
          "value": "surgical-safety",
          "label": "Surgical safety"
        },
        {
          "value": "infection-control",
          "label": "Infection control"
        },
        {
          "value": "falls-prevention",
          "label": "Falls prevention"
        },
        {
          "value": "near-miss-reporting",
          "label": "Near-miss reporting"
        }
      ],
      "required": true
    },
    {
      "id": "concerns",
      "label": "Known Concerns or Recent Incidents",
      "type": "textarea",
      "placeholder": "Describe any recent patient safety incidents, audit findings, or specific concerns to address...",
      "required": false
    }
  ],
  "recommendedPersonas": [
    "clinical-professional"
  ],
  "tags": [
    "healthcare",
    "patient-safety",
    "quality",
    "accreditation",
    "rca",
    "jci",
    "clinical-governance"
  ]
}
