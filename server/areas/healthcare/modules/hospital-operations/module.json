          "label": "General hospital"
        },
        {
          "value": "teaching-hospital",
          "label": "Teaching hospital"
        },
        {
          "value": "specialist-centre",
          "label": "Specialist centre"
        },
        {
          "value": "day-surgery",
          "label": "Day surgery"
        },
        {
          "value": "ed-emergency",
          "label": "ED/Emergency"
        }
      ],
      "required": true
    },
    {
      "id": "focus",
      "label": "Optimisation Focus Areas",
      "type": "multiselect",
      "options": [
        {
          "value": "patient-flow",
          "label": "Patient flow"
        },
        {
          "value": "bed-management",
          "label": "Bed management"
        },
        {
          "value": "or-theatre-utilisation",
          "label": "OR/theatre utilisation"
        },
        {
          "value": "ed-throughput",
          "label": "ED throughput"
        },
        {
          "value": "outpatient-scheduling",
          "label": "Outpatient scheduling"
        },
        {
          "value": "workforce",
          "label": "Workforce"
        },
        {
          "value": "cost-reduction",
          "label": "Cost reduction"
