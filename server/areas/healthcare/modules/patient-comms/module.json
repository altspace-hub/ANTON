{
  "formatVersion": "1.0",
  "id": "patient-comms",
  "label": "Patient Communication Materials",
  "shortLabel": "Patient Comms",
  "icon": "MessageSquare",
  "description": "Create clear, empathetic, and accessible patient communication materials. Covers patient information leaflets, consent forms, treatment explanations, discharge instructions, and health education content. Ensures materials meet health literacy standards, regulatory requirements, and accessibility guidelines while maintaining medical accuracy.",
  "color": "adv-red",
  "defaults": {
    "thinking": "think",
    "creativity": "balanced",
    "outputFormats": [
      "training-material"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "Health literacy standards, patient communication best practices, plain language guidelines, informed consent requirements, patient education frameworks"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "material-type",
      "label": "Material Type",
      "type": "select",
      "options": [
        {
          "value": "patient-information-leaflet",
          "label": "Patient information leaflet"
        },
        {
          "value": "consent-form",
          "label": "Consent form"
        },
        {
          "value": "treatment-explanation",
          "label": "Treatment explanation"
        },
        {
          "value": "discharge-instructions",
          "label": "Discharge instructions"
        },
        {
          "value": "health-education-material",
          "label": "Health education material"
        },
        {
          "value": "appointment-letter-reminder",
          "label": "Appointment letter/reminder"
        },
        {
          "value": "clinical-trial-information",
          "label": "Clinical trial information"
        },
        {
          "value": "faq-document",
          "label": "FAQ document"
        }
      ],
      "required": true
    },
    {
      "id": "clinical-topic",
      "label": "Clinical Topic",
      "type": "text",
      "placeholder": "e.g., Type 2 diabetes management, hip replacement surgery...",
      "required": true
    },
    {
      "id": "target-audience",
      "label": "Target Audience",
      "type": "select",
      "options": [
        {
          "value": "general-adult-patients",
          "label": "General adult patients"
        },
        {
          "value": "elderly-patients",
          "label": "Elderly patients"
        },
        {
          "value": "parents-caregivers",
          "label": "Parents/caregivers"
        },
        {
          "value": "adolescents",
          "label": "Adolescents"
        },
        {
          "value": "patients-with-low-health-literacy",
          "label": "Patients with low health literacy"
        },
        {
          "value": "non-native-language-speakers",
          "label": "Non-native language speakers"
        },
        {
          "value": "patients-with-specific-conditions",
          "label": "Patients with specific conditions"
        }
      ],
      "required": true
    },
    {
      "id": "reading-level",
      "label": "Target Reading Level",
      "type": "select",
      "options": [
        {
          "value": "simple-age-11-12-reading-level",
          "label": "Simple (age 11-12 reading level)"
        },
        {
          "value": "standard-age-14-16-reading-level",
          "label": "Standard (age 14-16 reading level)"
        },
        {
          "value": "detailed-educated-adult",
          "label": "Detailed (educated adult)"
        }
      ],
      "required": false
    },
    {
      "id": "key-information",
      "label": "Key Information to Include",
      "type": "textarea",
      "placeholder": "Main medical information, procedures, or instructions to cover...",
      "required": false
    }
  ],
  "recommendedPersonas": [
    "clinical-professional"
  ],
  "tags": [
    "healthcare",
    "patient",
    "communication",
    "education",
    "health-literacy"
  ],
  "contentType": "analytic_report"
}
