{
  "formatVersion": "1.0",
  "id": "pharma-market-access",
  "label": "Pharmaceutical Market Access Strategy",
  "shortLabel": "Market Access",
  "icon": "TrendingUp",
  "description": "Develop market access strategies for pharmaceutical and biotech products. Covers HTA submissions, reimbursement negotiations, pricing strategy, HEOR evidence generation, and payer engagement.",
  "color": "adv-teal",
  "defaults": {
    "thinking": "investigate",
    "creativity": "balanced",
    "outputFormats": [
      "executive-summary",
      "decision-memo",
      "action-plan"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "HTA methodologies, NICE cost-effectiveness, G-BA benefit assessment, HAS SMR/ASMR, HEOR evidence requirements, managed entry agreements, payer landscape, international reference pricing"
      }
    }
  },
  "guidedInputs": [
    {
      "id": "product_type",
      "label": "Product Type",
      "type": "select",
      "options": [
        {
          "value": "small-molecule",
          "label": "Small molecule"
        },
        {
          "value": "biologic",
          "label": "Biologic"
        },
        {
          "value": "oncology",
          "label": "Oncology"
        },
        {
          "value": "rare-disease",
          "label": "Rare disease"
        },
        {
          "value": "vaccine",
          "label": "Vaccine"
        },
        {
          "value": "diagnostic",
          "label": "Diagnostic"
        }
      ],
      "required": true
    },
    {
      "id": "markets",
      "label": "Target Markets",
      "type": "multiselect",
      "options": [
        {
          "value": "eu-ema",
          "label": "EU (EMA)"
        },
        {
          "value": "uk-nice-smc",
          "label": "UK (NICE/SMC)"
        },
        {
          "value": "germany-iqwig-g-ba",
          "label": "Germany (IQWiG/G-BA)"
        },
        {
          "value": "france-has",
          "label": "France (HAS)"
        },
        {
          "value": "us-commercial",
          "label": "US (commercial)"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ],
      "required": true
    },
    {
      "id": "launch_stage",
      "label": "Launch Stage",
      "type": "select",
      "options": [
        {
          "value": "early-development",
          "label": "Early development"
        },
        {
          "value": "phase-iii-planning",
          "label": "Phase III planning"
        },
        {
          "value": "pre-launch",
          "label": "Pre-launch"
        },
        {
          "value": "launch",
          "label": "Launch"
        },
        {
          "value": "post-launch-optimisation",
          "label": "Post-launch optimisation"
        }
      ],
      "required": true
    },
    {
      "id": "current_challenge",
      "label": "Current Market Access Challenge",
      "type": "textarea",
      "placeholder": "Describe your main market access challenge, reimbursement barrier, or strategic question...",
      "required": false
    }
  ],
  "recommendedPersonas": [
    "clinical-professional"
  ],
  "tags": [
    "healthcare",
    "market-access",
    "hta",
    "reimbursement",
    "heor",
    "pricing",
    "nice",
    "g-ba"
  ]
}
