        },
        {
          "value": "national_research",
          "label": "National Research Council"
        },
        {
          "value": "government_grant",
          "label": "Government Grant"
        },
        {
          "value": "foundation",
          "label": "Foundation / Charitable Grant"
        },
        {
          "value": "other",
          "label": "Other Funding Programme"
        }
      ]
