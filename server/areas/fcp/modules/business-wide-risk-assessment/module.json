{
  "formatVersion": "1.0",
  "id": "business-wide-risk-assessment",
  "label": "Business-Wide Risk Assessment (BWRA) — FCP",
  "shortLabel": "BWRA",
  "description": "AMLR Article 10 / FATF R.1 business-wide risk assessment for obliged entities. Follows the Risk Atlas seven-stage methodology and its scoring rules. Outputs a regulator-ready BWRA document; paste a Risk Atlas board pack to write it around the scores the institution already maintains.",
  "icon": "FileShield",
  "color": "adv-red",
  "areaId": "fcp",
  "defaults": {
    "thinking": "investigate",
    "creativity": "balanced",
    "outputFormats": ["risk-register", "policy-document", "executive-summary"],
    "knowledgeSources": {
      "claudeKnowledge": { "enabled": true, "webSearchEnabled": false, "description": "" },
      "localFolder": { "enabled": true, "folderPaths": [], "recursive": true }
    }
  },
  "guidedInputs": [
    { "id": "institution_type", "type": "select", "label": "Institution type", "required": true,
      "options": [
        { "value": "bank",                     "label": "Bank / Credit Institution" },
        { "value": "casp",                     "label": "Crypto-Asset Service Provider (CASP)" },
        { "value": "payment_institution",      "label": "Payment Institution / EMI" },
        { "value": "investment_firm",          "label": "Investment Firm (MiFID II)" },
        { "value": "insurance",                "label": "Life Insurer (obliged)" },
        { "value": "real_estate_agent",        "label": "Real Estate Agent" },
        { "value": "law_firm",                 "label": "Law Firm / Notary (obliged where applicable)" },
        { "value": "accountant_tax_advisor",   "label": "Accountant / Tax Advisor (obliged)" },
        { "value": "tcsp",                     "label": "Trust & Company Service Provider" },
        { "value": "high_value_dealer",        "label": "Dealer in High-Value Goods" },
        { "value": "gambling_operator",        "label": "Gambling Operator" },
        { "value": "crowdfunding",             "label": "Crowdfunding Service Provider" },
        { "value": "other_obliged",            "label": "Other obliged entity" }
      ]
    },
    { "id": "jurisdictions",     "type": "multi-select", "label": "Operating jurisdictions", "required": true,
      "options": [
        { "value": "EU",      "label": "European Union (any member state)" },
        { "value": "UK",      "label": "United Kingdom" },
        { "value": "US",      "label": "United States" },
        { "value": "Nordics", "label": "Nordics (SE/NO/DK/FI/IS)" },
        { "value": "global",  "label": "Other / global" }
      ]
    },
    { "id": "business_description", "type": "textarea", "label": "Business description", "required": true, "placeholder": "Customer base, services, channels, geographies, transaction volumes, key counterparties." },
    { "id": "atlas_board_pack", "type": "textarea", "label": "Risk Atlas board pack (optional)", "required": false, "placeholder": "Paste the board pack exported from your Risk Atlas (or upload the .docx). Its scores are used as they stand — the assessment writes around them rather than re-scoring." }
  ],
  "recommendedPersonas": ["senior-mlro", "senior-risk-officer", "risk-coach"],
  "recommendedSkills": ["threat-path-methodology", "control-evidence-scoring", "residual-calculation", "amlr-article-reference"],
  "tags": ["fcp", "bwra", "amlr", "amlr-article-10", "fatf", "atlas", "obliged-entity"],
  "contentType": "risk_register"
}
