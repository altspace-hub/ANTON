{
  "formatVersion": "1.0",
  "id": "risk-assessment",
  "label": "Risk Assessment",
  "shortLabel": "Risk",
  "icon": "BarChart3",
  "description": "ML/TF risk assessment support: maturity scoring, risk factor analysis, inherent/residual risk evaluation, and control effectiveness.",
  "color": "adv-gold",
  "defaults": {
    "thinking": "think_hard",
    "creativity": "balanced",
    "outputFormats": [
      "maturity-assessment",
      "detailed-findings"
    ],
    "transparencyLevel": 1,
    "knowledgeSources": {
