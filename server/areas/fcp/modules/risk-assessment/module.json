        "enabled": true,
        "webSearchEnabled": false,
        "description": ""
      }
    }
  },
  "guidedInputs": [
    {
      "id": "assessment_type",
      "type": "select",
      "label": "Assessment Type",
      "required": true,
      "options": [
        {
          "value": "bwra",
          "label": "Business-Wide Risk Assessment"
        },
        {
          "value": "product-risk",
          "label": "Product / Service Risk Assessment"
        },
        {
          "value": "customer-risk",
          "label": "Customer Risk Rating"
        },
        {
          "value": "country-risk",
          "label": "Country / Jurisdiction Risk"
        },
        {
          "value": "control-effectiveness",
          "label": "Control Effectiveness Review"
        },
        {
          "value": "maturity",
          "label": "Programme Maturity Assessment"
        }
      ]
    },
    {
      "id": "scope_description",
      "type": "textarea",
      "label": "Scope & Context",
      "placeholder": "Describe the institution, products/services, customer segments, and geographic exposure relevant to this assessment..."
    }
  ],
  "recommendedPersonas": [
    "fcp-expert",
    "data-scientist"
  ],
  "tags": [
    "risk",
