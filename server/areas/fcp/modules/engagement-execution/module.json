        "description": ""
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "execution_mode",
      "type": "select",
      "label": "Execution Mode",
      "required": true,
      "options": [
        {
          "value": "scope-parse",
          "label": "Parse engagement letter into scope items"
        },
        {
          "value": "deliverable-analysis",
          "label": "Analyze specific deliverable"
        },
        {
          "value": "progress-review",
          "label": "Review progress against scope"
        },
        {
          "value": "findings-synthesis",
          "label": "Synthesize findings across workstreams"
        }
      ]
    },
    {
      "id": "scope_context",
      "type": "textarea",
      "label": "Scope / Deliverable Context",
      "placeholder": "Paste the scope from the engagement letter, or describe the specific deliverable you are working on..."
    }
  ],
  "recommendedPersonas": [
    "fcp-expert"
  ],
  "tags": [
    "engagement",
