{
  "formatVersion": "1.0",
  "id": "vat-gst-compliance",
  "label": "VAT/GST Compliance Review",
  "shortLabel": "VAT/GST",
  "description": "Review indirect tax compliance across the supply chain. Identify registration obligations, input tax recovery issues, cross-border supply classification, reverse charge obligations, and e-invoicing requirements.",
  "icon": "Receipt",
  "color": "adv-gold",
  "areaId": "tax-transfer-pricing",
  "defaults": {
    "thinking": "think",
    "creativity": "strict",
    "outputFormats": [
      "gap-scoring-matrix",
      "action-plan",
      "regulatory-comparison"
    ],
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": true,
        "description": "EU VAT Directive, OECD VAT/GST guidelines, e-invoicing mandates, digital supply place-of-supply rules"
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "review_scope",
      "type": "multi-select",
      "label": "Review scope",
      "options": [
        {
          "value": "registration",
          "label": "VAT/GST registration obligations"
        },
        {
          "value": "cross_border_supplies",
          "label": "Cross-border supply classification (B2B / B2C)"
        },
        {
          "value": "input_recovery",
          "label": "Input tax recovery / partial exemption"
        },
        {
          "value": "reverse_charge",
          "label": "Reverse charge / self-assessment"
        },
        {
          "value": "e_invoicing",
          "label": "E-invoicing / mandatory invoice requirements"
        },
        {
          "value": "digital_services",
          "label": "Digital / electronic services supply rules"
        },
        {
          "value": "oss_ioss",
          "label": "EU OSS / IOSS (one-stop shop for e-commerce)"
        },
        {
          "value": "customs_vat",
          "label": "Import VAT / customs interface"
        },
        {
          "value": "intragroup_vat",
          "label": "Intragroup supplies / VAT grouping"
        }
      ]
    },
    {
      "id": "jurisdictions_vat",
      "type": "multi-select",
      "label": "VAT jurisdictions in scope",
      "options": [
        {
          "value": "eu_member_states",
          "label": "EU Member States (general)"
        },
        {
          "value": "uk",
          "label": "United Kingdom (post-Brexit)"
        },
        {
          "value": "no",
          "label": "Norway (MVA)"
        },
        {
          "value": "ch",
          "label": "Switzerland (MWST)"
        },
        {
          "value": "us",
          "label": "United States (Sales & Use Tax)"
        },
        {
          "value": "au",
          "label": "Australia (GST)"
        },
        {
          "value": "sg",
          "label": "Singapore (GST)"
        },
        {
          "value": "other",
          "label": "Other (describe in context)"
        }
      ]
    },
    {
      "id": "business_model",
      "type": "select",
      "label": "Business model",
      "options": [
        {
          "value": "b2b_services",
          "label": "B2B services (professional, digital, financial)"
        },
        {
          "value": "b2c_digital",
          "label": "B2C digital / e-commerce"
        },
        {
          "value": "goods_manufacturer",
          "label": "Goods — manufacturer / distributor"
        },
        {
          "value": "financial_services",
          "label": "Financial services (exempt / partially exempt)"
        },
        {
          "value": "real_estate",
          "label": "Real estate (exempt / optional taxation)"
        },
        {
          "value": "mixed",
          "label": "Mixed supply — taxable and exempt"
        }
      ]
    },
    {
      "id": "known_issues",
      "type": "textarea",
      "label": "Known issues or concerns",
      "placeholder": "e.g., recently started selling SaaS to German end consumers, uncertain about OSS registration; Belgium audit querying input recovery methodology; new e-invoicing mandate in France from 2026..."
    },
    {
      "id": "annual_vat_turnover",
      "type": "select",
      "label": "Annual taxable turnover (EU/UK VAT)",
      "options": [
        {
          "value": "below_registration",
          "label": "Below registration threshold (domestic)"
        },
        {
          "value": "above_registration",
          "label": "Above registration threshold — registered"
        },
        {
          "value": "large_enterprise",
          "label": "Large enterprise (>EUR 10M VAT turnover)"
        }
      ]
    }
  ],
  "recommendedPersonas": [
    "tax-director",
    "transfer-pricing-specialist"
  ],
  "modelTier": {
    "recommended": "sonnet",
    "minimum": "sonnet",
    "professional": "opus",
    "notes": "Standard compliance review is suitable for Sonnet; complex partial exemption or multi-jurisdiction OSS issues warrant Opus."
  },
  "tags": [
    "VAT",
    "GST",
    "indirect-tax",
    "EU-VAT-directive",
    "OSS",
    "IOSS",
    "e-invoicing",
    "reverse-charge",
    "digital-services",
    "input-recovery"
  ]
}
