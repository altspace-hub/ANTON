{
  "formatVersion": "1.0",
  "id": "dsr-handler",
  "label": "Data Subject Rights Handler",
  "shortLabel": "DSR Handler",
  "icon": "User",
  "description": "Manage data subject rights requests efficiently and compliantly. Covers process design, identity verification, system searches, exemption assessment, response drafting, and logging.",
  "color": "adv-teal",
  "areaId": "data-privacy",
  "defaults": {
    "thinking": "think",
    "creativity": "strict",
    "outputFormats": [
      "action-plan",
      "policy-document"
    ],
    "knowledgeSources": {
      "claudeKnowledge": {
        "enabled": true,
        "webSearchEnabled": false,
        "description": "GDPR Articles 15-22 (data subject rights), EDPB guidelines on data subject rights, ICO SAR guidance"
      },
      "localFolder": {
        "enabled": true,
        "folderPaths": [],
        "recursive": true
      }
    }
  },
  "guidedInputs": [
    {
      "id": "request_type",
      "type": "select",
      "label": "Type of data subject request",
      "required": true,
      "options": [
        {
          "value": "access_sar",
          "label": "Access (SAR)"
        },
        {
          "value": "erasure",
          "label": "Erasure (right to be forgotten)"
        },
        {
          "value": "rectification",
          "label": "Rectification"
        },
        {
          "value": "portability",
          "label": "Portability"
        },
        {
          "value": "restriction",
          "label": "Restriction"
        },
        {
          "value": "objection",
          "label": "Objection"
        },
        {
          "value": "automated_opt_out",
          "label": "Automated decision opt-out"
        }
      ]
    },
    {
      "id": "received_date",
      "type": "text",
      "label": "Date the request was received",
      "description": "The response deadline runs from receipt of a valid request, not from the day you start work on it.",
      "placeholder": "e.g. 3 September 2026"
    },
    {
      "id": "data_subject_type",
      "type": "select",
      "label": "Who is the data subject?",
      "description": "Changes which systems must be searched and which exemptions can apply.",
      "options": [
        {
          "value": "current_customer",
          "label": "Current customer"
        },
        {
          "value": "former_customer",
          "label": "Former customer"
        },
        {
          "value": "employee",
          "label": "Employee / former employee"
        },
        {
          "value": "prospect_declined",
          "label": "Prospect / declined application"
        },
        {
          "value": "third_party",
          "label": "Third party (guarantor, UBO, joint account holder)"
        },
        {
          "value": "unverified",
          "label": "Unknown / identity not yet verified"
        }
      ]
    },
    {
      "id": "potential_exemptions",
      "type": "multi-select",
      "label": "Potential exemptions or restrictions in play",
      "description": "Flag anything that may apply. An AML or sanctions flag escalates to the MLRO and Legal before any disclosure.",
      "options": [
        {
          "value": "aml_tipping_off",
          "label": "AML / tipping-off restriction (STR/SAR or FIU disclosure in scope)"
        },
        {
          "value": "sanctions",
          "label": "Sanctions match, freeze or licence application"
        },
        {
          "value": "ongoing_investigation",
          "label": "Ongoing regulatory or law-enforcement investigation"
        },
        {
          "value": "crime_prevention",
          "label": "Crime prevention / detection (national derogation)"
        },
        {
          "value": "legal_privilege",
          "label": "Legal professional privilege"
        },
        {
          "value": "third_party_data",
          "label": "Third-party personal data requiring redaction"
        },
        {
          "value": "retention_obligation",
          "label": "Statutory retention obligation blocking erasure"
        },
        {
          "value": "manifestly_excessive",
          "label": "Manifestly unfounded or excessive"
        },
        {
          "value": "none_known",
          "label": "None known"
        }
      ]
    },
    {
      "id": "complexity",
      "type": "select",
      "label": "Request complexity",
      "options": [
        {
          "value": "straightforward",
          "label": "Straightforward"
        },
        {
          "value": "complex",
          "label": "Complex (multiple systems)"
        },
        {
          "value": "contentious",
          "label": "Contentious"
        },
        {
          "value": "exemption",
          "label": "Potential exemption"
        }
      ]
    },
    {
      "id": "volume",
      "type": "select",
      "label": "Request volume (organisation-wide)",
      "options": [
        {
          "value": "single",
          "label": "Single request"
        },
        {
          "value": "low",
          "label": "<10/month"
        },
        {
          "value": "medium",
          "label": "10–100/month"
        },
        {
          "value": "high",
          "label": ">100/month"
        }
      ]
    },
    {
      "id": "systems_involved",
      "type": "textarea",
      "label": "Systems likely to hold data",
      "placeholder": "e.g., CRM (Salesforce), email archives (Exchange), data warehouse (Snowflake), backup tapes"
    }
  ],
  "recommendedPersonas": [
    "dpo"
  ],
  "tags": [
    "dsr",
    "sar",
    "data-subject-rights",
    "gdpr",
    "erasure",
    "access-request",
    "right-to-be-forgotten"
  ],
  "contentType": "plan_document"
}
