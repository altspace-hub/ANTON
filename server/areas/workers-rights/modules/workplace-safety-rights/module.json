        {
          "value": "uae",
          "label": "UAE (migrant worker)"
        },
        {
          "value": "other",
          "label": "Other country"
        }
      ]
    },
    {
      "id": "industry",
      "label": "What kind of workplace is it?",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "construction",
          "label": "Construction / building site"
        },
        {
          "value": "factory-manufacturing",
          "label": "Factory / manufacturing"
        },
        {
          "value": "agriculture",
          "label": "Agriculture / farming"
        },
        {
          "value": "mining",
          "label": "Mining"
        },
        {
          "value": "domestic",
          "label": "Domestic / household work"
        },
        {
          "value": "transport",
          "label": "Transport / driving"
        },
        {
          "value": "hospitality",
          "label": "Hospitality / kitchen"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ]
    },
    {
      "id": "hazard_type",
      "label": "What is the safety problem? (choose all that apply)",
      "type": "chips",
      "required": false,
      "options": [
        {
          "value": "chemical",
          "label": "Chemical exposure"
        },
        {
          "value": "falls-heights",
          "label": "Falls or working at heights"
        },
        {
          "value": "machinery",
          "label": "Dangerous machinery"
        },
        {
          "value": "heat-sun",
          "label": "Extreme heat or sun"
        },
        {
          "value": "violence",
          "label": "Violence or threats"
        },
        {
          "value": "sexual-harassment",
          "label": "Sexual harassment"
        },
        {
          "value": "no-ppe",
          "label": "No protective equipment"
        },
        {
          "value": "other",
          "label": "Other hazard"
        }
      ]
    },
    {
      "id": "urgency",
      "label": "How urgent is this?",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "immediate-danger",
          "label": "Dangerous situation right now"
        },
        {
          "value": "recent-accident",
          "label": "There was an accident recently"
        },
        {
          "value": "ongoing-concern",
          "label": "Ongoing concern I want to report"
        },
        {
          "value": "general-info",
          "label": "I want to understand my rights generally"
        }
      ]
    }
