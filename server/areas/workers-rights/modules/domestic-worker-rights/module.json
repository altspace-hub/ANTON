{
  "formatVersion": "1.0",
  "id": "domestic-worker-rights",
  "label": "Domestic Worker Protection",
  "shortLabel": "Domestic Workers",
  "icon": "Home",
  "description": "Rights for household workers — cleaners, cooks, nannies, and caregivers — including on hours, leave, pay, and living conditions.",
  "color": "adv-teal",
  "modelTier": {
    "recommended": "haiku",
    "minimum": "ollama-local",
    "professional": "sonnet",
    "notes": "Complex legal disputes need sonnet. Basic domestic worker rights information works well with haiku."
  },
  "defaults": {
    "thinking": "think",
    "creativity": "balanced",
    "outputFormats": ["quick-briefing"],
    "transparencyLevel": 0,
    "knowledgeSources": {
      "claudeKnowledge": { "enabled": true, "webSearchEnabled": false, "description": "Domestic worker rights by country, ILO Convention 189, hours, rest days, live-in conditions, termination, sexual harassment protections" }
    }
  },
  "guidedInputs": [
    {
      "id": "country",
      "label": "Which country do you work in?",
      "type": "select",
      "required": true,
      "options": [
        { "value": "kenya", "label": "Kenya" },
        { "value": "nigeria", "label": "Nigeria" },
        { "value": "ghana", "label": "Ghana" },
        { "value": "tanzania", "label": "Tanzania" },
        { "value": "south-africa", "label": "South Africa" },
        { "value": "india", "label": "India" },
        { "value": "bangladesh", "label": "Bangladesh" },
        { "value": "pakistan", "label": "Pakistan" },
        { "value": "philippines", "label": "Philippines" },
        { "value": "saudi-arabia", "label": "Saudi Arabia (migrant worker)" },
        { "value": "uae", "label": "UAE (migrant worker)" },
        { "value": "other", "label": "Other country" }
      ]
    },
    {
      "id": "live_in_or_out",
      "label": "Do you live in the employer's home?",
      "type": "select",
      "required": true,
      "options": [
        { "value": "live-in", "label": "Yes — I live in the employer's home" },
        { "value": "live-out", "label": "No — I travel to and from work each day" },
        { "value": "part-time-multiple", "label": "Part-time — I work for several employers" }
      ]
    },
    {
      "id": "employment_type",
      "label": "How are you employed?",
      "type": "select",
      "required": true,
      "options": [
        { "value": "direct-employer", "label": "Directly by the household (no agency)" },
        { "value": "through-agency", "label": "Through an employment agency" },
        { "value": "family-informal", "label": "Family or informal arrangement (no written agreement)" }
      ]
    },
    {
      "id": "issue",
      "label": "What do you want help with?",
      "type": "select",
      "required": true,
      "options": [
        { "value": "hours", "label": "Working hours and rest time" },
        { "value": "pay-deductions", "label": "Pay and deductions from wages" },
        { "value": "leave", "label": "Leave entitlement (annual, sick, maternity)" },
        { "value": "housing-food", "label": "Housing and food conditions (live-in)" },
        { "value": "abuse-mistreatment", "label": "Abuse or mistreatment" },
        { "value": "ending-employment", "label": "Ending my employment and leaving" }
      ]
    }
  ],
  "recommendedPersonas": ["paralegal-aid", "gig-economy-rights-advisor"],
  "tags": ["workers-rights", "bop", "informal-economy", "domestic-workers", "household-workers", "ilo-c189", "live-in", "abuse", "rest-day", "leave"]
}
