      "required": true,
      "options": [
        {
          "value": "1-3-months",
          "label": "In 1 to 3 months"
        },
        {
          "value": "3-6-months",
          "label": "In 3 to 6 months"
        },
        {
          "value": "6-12-months",
          "label": "In 6 to 12 months"
        },
        {
          "value": "over-1-year",
          "label": "Over 1 year from now"
        }
      ]
    },
    {
      "id": "current_savings",
      "type": "select",
      "label": "How much have you saved already?",
      "required": false,
      "options": [
        {
          "value": "nothing",
          "label": "Nothing saved yet"
