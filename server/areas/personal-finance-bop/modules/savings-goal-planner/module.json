        {
          "value": "less-1-month",
          "label": "Less than 1 month of income"
        },
        {
          "value": "1-3-months",
          "label": "1 to 3 months of income"
        },
        {
          "value": "more-3-months",
          "label": "More than 3 months of income"
        }
      ]
    }
