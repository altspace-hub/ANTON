{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "anton:content-type:analytic_report:1.0",
  "title": "Analytic Report",
  "description": "Narrative analysis with findings and recommendations. Most permissive content type — default for modules that don't fit a stricter schema.",
  "type": "object",
  "required": ["title", "sections"],
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "executive_summary": { "type": "string", "description": "2-4 sentence summary for the top of the report" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading"],
        "properties": {
          "heading": { "type": "string" },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "body": { "type": "string", "description": "Markdown content" },
          "subsections": {
            "type": "array",
            "items": { "$ref": "#/properties/sections/items" }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Key findings extracted as structured items — feeds board-deck and one-pager renderers",
      "items": {
        "type": "object",
        "required": ["finding"],
        "properties": {
          "id": { "type": "string" },
          "finding": { "type": "string" },
          "evidence": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
          "category": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendation"],
        "properties": {
          "id": { "type": "string" },
          "recommendation": { "type": "string" },
          "rationale": { "type": "string" },
          "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "owner": { "type": "string" },
          "target_date": { "type": "string", "format": "date" },
          "effort": { "type": "string", "enum": ["S", "M", "L", "XL"] }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string" },
          "date": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
