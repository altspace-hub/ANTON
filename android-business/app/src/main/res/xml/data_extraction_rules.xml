<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replacement for fullBackupContent. Disallows cloud + device
  transfer of the entire app data tree, for the same reason as
  backup_rules.xml: ANTON Comm holds the Ed25519 private key + plaintext
  messages, neither of which should leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
