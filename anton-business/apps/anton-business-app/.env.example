# anton-business-app environment.
# Copy to .env and fill in. .env files are gitignored at the root.

# Backend HTTP base URL. EXPO_PUBLIC_* env vars are inlined at build
# time and available via process.env in the bundle.
#
# Local dev with a USB-tethered phone:
#   adb reverse tcp:8787 tcp:8787
#   EXPO_PUBLIC_API_BASE=http://localhost:8787
#
# Local dev with Android emulator:
#   EXPO_PUBLIC_API_BASE=http://10.0.2.2:8787
#
# Local dev with a physical phone on the same LAN (slower):
#   EXPO_PUBLIC_API_BASE=http://<dev-machine-IP>:8787
EXPO_PUBLIC_API_BASE=http://localhost:8787
