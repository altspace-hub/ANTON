# merchant-backend environment.
# Copy to .env and fill in. The .env file is gitignored.

# ── HTTP server ─────────────────────────────────────────────
PORT=8787

# ── PostgreSQL ──────────────────────────────────────────────
# Suggest reusing the same Postgres instance as ANTON Local in dev,
# but with a separate database (anton_business) and user.
DATABASE_URL=postgresql://anton_business:anton_business@localhost:5432/anton_business

# ── FutureChain RPC ─────────────────────────────────────────
# Point at testnet during development. Spec §1.1 says merchants never
# hold funds via us — the backend submits delegated settlement txs.
FUTURECHAIN_RPC_URL=https://testnet.futurechain.org
# FUTURECHAIN_AUTH_TOKEN=

# ── Safello ─────────────────────────────────────────────────
# Pre-launch — fill in once the commercial deal is signed.
# SAFELLO_API_URL=https://api.safello.com/v1
# SAFELLO_API_KEY=
# SAFELLO_MERCHANT_ID=

# ── Email (kvitto + daily report) ───────────────────────────
# Pick one — Resend or Postmark. Spec §5.1 mentions both.
# RESEND_API_KEY=
# POSTMARK_TOKEN=

# ── Observability ───────────────────────────────────────────
RUST_LOG=merchant_backend=debug,tower_http=info,axum=info
