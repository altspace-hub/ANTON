{
  "name": "@futurechain/sdk",
  "version": "0.0.1",
  "description": "Shared TypeScript SDK for FutureChain — wallet, PACS.008, RPC, reference encoding. Consumed by ANTON Business and (later) ANTON Wallet.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pacs008": "./src/pacs008/index.ts",
    "./wallet": "./src/wallet/index.ts",
    "./rpc": "./src/rpc/index.ts",
    "./reference": "./src/reference/index.ts",
    "./delegation": "./src/delegation/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.6.1",
    "@noble/secp256k1": "^2.2.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
