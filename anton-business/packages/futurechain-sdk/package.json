{
  "name": "@futurechain/sdk",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "description": "Shared TypeScript SDK for FutureChain — wallet, PACS.008, RPC, reference encoding. Consumed by ANTON Business and (later) ANTON Wallet.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pacs008": "./src/pacs008/index.ts",
    "./wallet": "./src/wallet/index.ts",
    "./rpc": "./src/rpc/index.ts",
    "./reference": "./src/reference/index.ts",
    "./tax": "./src/tax/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
