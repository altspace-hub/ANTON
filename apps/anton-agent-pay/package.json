{
  "name": "@anton/agent-pay",
  "version": "0.0.1",
  "private": true,
  "description": "Anton Agent Pay — desktop wallet exposing a local JSON-RPC + MCP server so third-party AI agents can drive FTC payments under human-in-the-loop confirmation. See docs/ANTON_AGENT_PAY_SPEC.md.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:server": "tsx src/main/server-only.ts",
    "start:electron": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.8.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "electron": "^33.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  }
}
