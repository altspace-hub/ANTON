{
  "name": "openexpert",
  "version": "0.6.0",
  "private": true,
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"pnpm run dev:client\" \"pnpm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "db:init": "tsx server/db/init.ts",
    "db:init:enhanced": "tsx server/db/init_enhanced.ts",
    "db:migrate": "tsx server/db/run_migrations.ts",
    "db:migrate:workspaces": "tsx server/db/migrate-workspaces.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src server --ext .ts,.tsx --max-warnings 100",
    "lint:fix": "eslint src server --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "preview": "vite preview",
    "mcp": "tsx server/mcp/openexpert-mcp.ts",
    "mcp:build": "tsc --outDir dist --module NodeNext --moduleResolution NodeNext --target ES2022 --esModuleInterop true --skipLibCheck true server/mcp/openexpert-mcp.ts",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix",
    "audit:full": "bash ./scripts/audit-dependencies.sh",
    "licenses": "pnpm dlx license-checker --summary",
    "licenses:full": "pnpm dlx license-checker --csv --out licenses-report.csv",
    "licenses:report": "node scripts/generate-license-report.js",
    "outdated": "pnpm outdated",
    "validate:locales": "node scripts/validate-locales.mjs",
    "security:report": "node scripts/vulnerability-report.js",
    "security:audit": "tsx scripts/security-audit.ts",
    "security:pentest": "tsx scripts/security-audit.ts",
    "test:intelligent": "tsx scripts/intelligent-testing.ts",
    "test:claude": "tsx scripts/intelligent-testing.ts",
    "test:audit": "tsx test-audit.ts",
    "electron:dev": "concurrently \"pnpm run dev:server\" \"sleep 3 && electron .\"",
    "electron:build": "electron-rebuild -f -w better-sqlite3 && pnpm run build && tsc -p tsconfig.server.build.json && tsc -p tsconfig.electron.json && electron-builder",
    "electron:pack": "electron-builder --dir",
    "electron:icons": "tsx scripts/generate-icons.ts",
    "postinstall": "echo 'Run pnpm run electron:build to rebuild native modules for Electron'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@tanstack/react-virtual": "^3.13.21",
    "@types/jszip": "^3.4.1",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "chromadb": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "docx": "^9.5.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "file-type": "^19.6.0",
    "fs-extra": "^11.2.0",
    "helmet": "^8.1.0",
    "i18next": "^23.16.8",
    "i18next-http-backend": "^3.0.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.11.0",
    "mongodb": "^7.1.0",
    "mssql": "^12.2.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.17.3",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "openai": "^4.28.0",
    "openid-client": "^6.8.2",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^6.28.1",
    "recharts": "^3.7.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "speakeasy": "^2.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.6",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^11.0.0",
    "@types/xlsx": "^0.0.36",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "license-checker": "^25.0.1",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.6",
    "tiktoken": "^1.0.22",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "rollup": "4.57.1"
    }
  }
}
