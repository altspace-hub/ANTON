# ── ANTON Channel Bridge ──────────────────────────────────
# The full URL to your ANTON bridge endpoint
# Format: http(s)://<your-anton-host>/api/bridges/<bridge-id>/query
ANTON_BRIDGE_URL=https://anton.your-org.com/api/bridges/YOUR_BRIDGE_ID/query

# The bearer token from the Channel Bridges wizard (shown once at creation)
BRIDGE_TOKEN=your_64_char_hex_token_here

# ── WhatsApp Cloud API ────────────────────────────────────
# Found in Meta App Dashboard → WhatsApp → API Setup
PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# ── Webhook Verification ──────────────────────────────────
# A string YOU choose — must match what you enter in Meta App → Webhook config
VERIFY_TOKEN=choose_a_random_string_here

# ── Server ────────────────────────────────────────────────
PORT=3000
