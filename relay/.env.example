# ANTON Mesh Relay — docker-compose .env template.
#
# Copy to `.env` (gitignored), fill in, then `docker compose up -d`.
# Secrets (POSTGRES_PASSWORD, RELAY_OPERATOR_PASSWORD, RELAY_OPERATOR_JWT_SECRET)
# should be generated locally — never committed.

# ── REQUIRED ─────────────────────────────────────────────────────────

# Canonical URL phones use to dial this relay. Must match wss:// in
# production; ws:// only acceptable with RELAY_INSECURE=1 + a reverse
# proxy terminating TLS.
RELAY_URL=wss://relay.futurechain.eu

# When running behind Caddy/nginx/Cloudflare that handles TLS:
RELAY_INSECURE=1

# Bundled-Postgres path (recommended for v0.2 first deploy):
POSTGRES_USER=relay
POSTGRES_DB=relay_registry
# 32+ chars from `openssl rand -hex 32` — paste between the quotes:
POSTGRES_PASSWORD="CHANGE_ME"

# Registry DB URL that the relay container uses to reach Postgres.
# When using the bundled `registry-db` service, the hostname is
# `registry-db` (docker-compose service name resolved on the
# internal network). When using an external DB, replace this whole
# line with your provider's URL.
RELAY_REGISTRY_DATABASE_URL=postgresql://relay:${POSTGRES_PASSWORD}@registry-db:5432/relay_registry

# Operator login (used by /v1/admin/login + the operator review UI).
# Both must be set together — leaving either blank disables /v1/admin/*.
RELAY_OPERATOR_PASSWORD="CHANGE_ME"
RELAY_OPERATOR_JWT_SECRET="CHANGE_ME"

# ── OPTIONAL ─────────────────────────────────────────────────────────

# Bind port. Default 8443. Use a non-privileged port behind a reverse proxy.
# RELAY_PORT=8443

# Mount path for TLS certs when terminating TLS at the relay (rare):
# RELAY_CERT_DIR=/etc/letsencrypt/live/relay.futurechain.eu
# RELAY_TLS_CERT=/certs/fullchain.pem
# RELAY_TLS_KEY=/certs/privkey.pem

# Audit log path inside the container. Defaults to stdout (Docker logs).
# RELAY_AUDIT_LOG_PATH=/app/audit/relay.jsonl
