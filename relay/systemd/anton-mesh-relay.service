[Unit]
Description=ANTON Mesh Relay
Documentation=https://github.com/openexpert/anton/blob/main/docs/ANTON_MESH_SPEC.md
After=network.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/anton-mesh-relay/dist/index.js
WorkingDirectory=/opt/anton-mesh-relay
Restart=on-failure
RestartSec=5

# Run as the dedicated `anton-relay` user — create with:
#   useradd --system --no-create-home --shell /usr/sbin/nologin anton-relay
User=anton-relay
Group=anton-relay

# Environment — operators override these in /etc/anton-mesh-relay/env
EnvironmentFile=/etc/anton-mesh-relay/env

# ── Hardening ────────────────────────────────────────────────────────
# Defense-in-depth: the relay process has no reason to do anything
# beyond accepting WS connections and forwarding bytes between matched
# legs. Lock everything else down.

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Bind only to the relay port — the unit operator opens ufw / firewalld
# manually so this is informational. Read the cert mount if RELAY_TLS_CERT
# is set; otherwise no filesystem writes whatsoever.
ReadOnlyPaths=/etc/letsencrypt
ReadWritePaths=/var/log/anton-mesh-relay

# Bound resources.
MemoryMax=512M
TasksMax=1024
LimitNOFILE=65536

# Capability drop: the relay only needs to bind to its (non-privileged)
# port. CAP_NET_BIND_SERVICE is required only if RELAY_PORT < 1024 — most
# operators should run on 8443 or higher and not need this.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
