# /etc/anton-mesh-relay/env — environment for the systemd unit.
# Copy this to /etc/anton-mesh-relay/env and edit. Permissions: 0640 root:anton-relay.

# ── REQUIRED ─────────────────────────────────────────────────────────

# Canonical URL phones use to dial this relay. MUST match wss:// scheme
# (or ws:// with RELAY_INSECURE=1 below for behind-reverse-proxy mode).
# This value is verified against every HELLO_INSTANCE proof signature.
RELAY_URL=wss://r1.example.org

# ── OPTIONAL ─────────────────────────────────────────────────────────

# Listen port. Default 8443. Use a non-privileged port (>=1024) so the
# unit doesn't need CAP_NET_BIND_SERVICE.
RELAY_PORT=8443
RELAY_HOST=0.0.0.0

# TLS termination — provide BOTH or NEITHER.
# RELAY_TLS_CERT=/etc/letsencrypt/live/r1.example.org/fullchain.pem
# RELAY_TLS_KEY=/etc/letsencrypt/live/r1.example.org/privkey.pem

# Reverse-proxy mode (Caddy/nginx in front handles TLS).
# Set to 1 if you intentionally run plain WS.
# RELAY_INSECURE=1

# Concurrent-session ceiling per instance (spec §3.10). Default 32.
# Hard ceiling 256.
# RELAY_MAX_SESSIONS_PER_INSTANCE=32

# Audit log file path. Defaults to stdout (= journald via systemd).
# RELAY_AUDIT_LOG_PATH=/var/log/anton-mesh-relay/audit.jsonl
