# ─────────────────────────────────────────────────────────────────────────────
# openEXPERT — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Your Anthropic API key. Get one at https://console.anthropic.com
# All Claude API calls are made server-side using this key.
# Alternatively, leave this unset and paste the key in the app:
# Settings → General → Additional AI Providers. Keys saved there are
# persisted in the database (AES-256-GCM encrypted at rest when
# INSTANCE_KEY_ENCRYPTION_KEY is set), survive restarts, and override
# the .env value.
ANTHROPIC_API_KEY=sk-ant-...

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Express server listens on.
PORT=3001

# Deployment mode:
#   solo  — no authentication, single-user local mode (default)
#   team  — JWT-based authentication for shared deployments
DEPLOYMENT_MODE=solo

# Required when DEPLOYMENT_MODE=team.
# Generate a secure value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# Encryption key for sensitive connection credentials (passwords, API keys).
# Generate a 64-character hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, uses a default key (INSECURE — only for development!)
ENCRYPTION_KEY=

# MCP Server Authentication (team mode only)
# Generate with: openssl rand -hex 32
MCP_SECRET=

# How long a login session lasts (uses zeit/ms format: 1h, 8h, 7d).
JWT_EXPIRY=8h

# Comma-separated allowed CORS origins. Add your domain in team/production deployments.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ── Storage ───────────────────────────────────────────────────────────────────

# Directory for user-uploaded files. Must be writable by the server process.
UPLOAD_DIR=./uploads

# Comma-separated list of base directories that the folder-browser API is
# allowed to access. Requests for paths outside this list are rejected with 403.
# Expand this list if users need to browse additional directories.
# Default: uploads and outputs only (safe for local/team deployments).
ALLOWED_FOLDER_PATHS=./uploads,./outputs

# Directory for generated export files (.docx, .xlsx, .pdf, .pptx).
OUTPUT_DIR=./outputs

# Directory for project workspaces (uploads, outputs, RAG, collaboration).
# Each project gets its own subdirectory: /workspaces/{project-id}/
WORKSPACES_DIR=./workspaces

# PostgreSQL connection string. REQUIRED — ANTON runs on PostgreSQL only.
# Auto-enables team mode unless DEPLOYMENT_MODE is explicitly set.
# Example: postgresql://anton:password@localhost:5432/anton
# DATABASE_URL=

# PostgreSQL pool settings (only used when DATABASE_URL is set).
# PG_POOL_MAX=20
# PG_POOL_IDLE_TIMEOUT=30000
# PG_CONNECTION_TIMEOUT=5000

# Path to ChromaDB vector database storage.
CHROMA_PATH=./data/chroma
# NOTE: vector RAG embeddings use OpenAI (text-embedding-3-small) and require
# OPENAI_API_KEY. Without it, knowledge/RAG search falls back to keyword search.
# OLLAMA_EMBEDDING_MODEL (below) affects institutional-memory/atom embeddings only.

# Vector backend for the institutional-memory / knowledge-atom embeddings table
# (the VectorStoreAdapter path — distinct from the ChromaDB collection RAG above).
#   sqlite   (default) — in-process JS cosine over the embeddings table. No setup.
#   pgvector           — Postgres pgvector HNSW index (faster at scale). Requires
#                        the pgvector extension installed on the Postgres host
#                        (e.g. `apt install postgresql-16-pgvector`), then run
#                        `POST /api/embeddings/backfill-vec` once to create the
#                        column/index + copy existing vectors. Falls back to the
#                        JS store automatically if the extension/column is absent.
# VECTOR_BACKEND=sqlite

# Maximum size for a single uploaded file (megabytes).
MAX_FILE_SIZE_MB=50

# ── AI Defaults ───────────────────────────────────────────────────────────────
# Applied when a user has not overridden the setting for their session.

# Default model. Also drives the specialty/automation routes: set this to a
# non-Claude id (e.g. mistral-large-latest, ollama:qwen2.5, compat:<slug>:<model>)
# and those routes run on that provider instead of Claude.
# NOTE: the model picked in Settings → General is persisted server-side
# (app_settings 'default_model') and OVERRIDES this value. Precedence:
# session model (per run) > Settings choice > DEFAULT_MODEL > provider key
# priority (Anthropic > Mistral > OpenAI > Google). See docs/RUN_ON_CHEAP_MODELS.md.
# Claude options: claude-opus-4-8 | claude-opus-4-7 | claude-opus-4-6 | claude-sonnet-4-6 | claude-sonnet-4-5-20250929 | claude-haiku-4-5-20251001
DEFAULT_MODEL=claude-opus-4-8

# Default thinking level.
# Options: quick | think | think_hard | investigate | plan_first
DEFAULT_THINKING=think_hard

# Default creativity level.
# Options: strict | balanced | creative
DEFAULT_CREATIVITY=balanced

# GLOBAL CAP on input tokens for pre-flight validation. The effective budget
# is now per-model (capability-aware): min(this cap, the model's real context
# window minus output/system reserve). A 32k Ollama model gets ~16k of
# knowledge budget regardless of this value; 1M Claude models get 800k.
MAX_CONTEXT_TOKENS=900000

# ── Multi-LLM Providers (optional) ───────────────────────────────────────────
# Setting these keys enables the corresponding models in the model selector.
# Leave blank or omit to disable non-Claude models.

# OpenAI — enables GPT-4o and GPT-4o-mini
OPENAI_API_KEY=sk-...

# Google AI — enables Gemini 1.5 Pro and Gemini 1.5 Flash
GOOGLE_API_KEY=

# Mistral — enables Mistral Large and Mistral Small
MISTRAL_API_KEY=

# ApeAPI — a cheap OpenAI-compatible multi-model bundle (Grok, Kimi, GLM, GPT-5.5-mini,
# and more through one key). Setting APEAPI_API_KEY auto-registers ApeAPI as a
# compat: endpoint at boot (slug 'apeapi'); its models become addressable as
# compat:apeapi:<model> — usable as a main chat model AND as the double-check verifier
# (Settings → Double-check). Confirm the OpenAI-compatible base URL with the vendor and
# set APEAPI_BASE_URL (must end in /v1). After first boot, run a health check in
# Settings → Model endpoints to discover the available models.
APEAPI_API_KEY=
APEAPI_BASE_URL=

# Moonshot AI (Kimi) — OpenAI-compatible. Setting MOONSHOT_API_KEY auto-registers it
# as a compat: endpoint at boot (slug 'kimi'); models become addressable as
# compat:kimi:<model>, usable as a main chat model AND as the double-check verifier.
# After first boot, run a health check in Settings → Local & cost-effective models to
# discover models. Current catalogue: kimi-k3 (1M context, flagship), kimi-k2.7-code
# and kimi-k2.7-code-highspeed (256k, coding/agentic), kimi-k2.6 (256k, multimodal).
# The kimi-k2 / k2.5 series were discontinued May 2026 — platform sunset 31 Aug 2026.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=

# Bing Web Search (optional) — gives NON-Claude providers (Mistral/OpenAI/Gemini/
# Ollama/compat) live web grounding when web search is requested (Claude uses its
# own native web_search tool). Without this, non-Claude web-search runs ungrounded.
BING_SEARCH_API_KEY=

# ── Ollama local LLM (optional) ──────────────────────────────────────────────
# Run open-source models locally for free inference (no API key required).
# Install Ollama from https://ollama.com, then pull a model: ollama pull llama3.2
# The app auto-detects running models via /api/ollama/models.
OLLAMA_BASE_URL=http://localhost:11434

# ── Seller auto-quote + four-eyes review (commerce-loop P3, optional) ─────────
# A seller portal can answer a buyer agent's inquiry with a synchronous priced
# quote via an LLM. Both knobs reuse the provider keys above — NO key is shipped
# in the repo; each operator supplies their own.
#
# ANTON_AUTOQUOTE_MODEL — the model that produces the quote (default when blank:
# claude-haiku-4-5-20251001). Set e.g. mistral-large-latest to quote via Mistral.
ANTON_AUTOQUOTE_MODEL=
#
# ANTON_AUTOQUOTE_REVIEW_MODEL — OPTIONAL independent "four-eyes" reviewer. OFF by
# default (leave blank). NOTE: the double-check is now also configurable in the UI
# (Settings → Double-check: toggle + verifier-model dropdown), which TAKES PRECEDENCE
# over this env var when enabled. This var remains as a headless/legacy fallback.
# When set, a SECOND, independent model reviews every quote
# (and the untrusted buyer inquiry) for no-go zones, prompt-injection/manipulation,
# and anomalies, and ROUTES THE QUOTE TO A HUMAN if it raises a concern. Use a model
# from a DIFFERENT provider than ANTON_AUTOQUOTE_MODEL (e.g. mistral-large-latest
# reviewing a Claude quote) so one model can't rubber-stamp itself. Requires that
# provider's key (e.g. MISTRAL_API_KEY) above.
ANTON_AUTOQUOTE_REVIEW_MODEL=
#
# ANTON_AUTOQUOTE_REVIEW_POLICY — OPTIONAL extra no-go policy text appended to the
# four-eyes reviewer's instructions (e.g. "Never quote weapons or prescription drugs.").
ANTON_AUTOQUOTE_REVIEW_POLICY=

# ── Buyer-side agreement four-eyes (anton-collaboration standalone, optional) ──
# Independent second-model review of an agreement BEFORE the buyer's human gate.
# OFF unless ANTON_COLLAB_REVIEW_MODEL is set; uses the matching provider key above
# (operator-supplied — no key ships in the repo). Use a DIFFERENT model/provider
# than the negotiation brain (e.g. mistral-large-latest reviewing a Claude brain).
# ANTON_COLLAB_REVIEW_MODEL=
# ANTON_COLLAB_REVIEW_STRICT=1     # auto-reject a raised proposal (default: advisory)
# ANTON_COLLAB_REVIEW_POLICY=      # extra no-go policy text for the reviewer

# Context length (num_ctx) requested from Ollama per chat call. ANTON uses
# min(the model's trained context length from /api/show, this value).
# Raise it on machines with plenty of RAM/VRAM; default 32768.
# OLLAMA_NUM_CTX=32768

# Ollama embedding model — used for APCI hybrid memory retrieval.
# Pull the model first: ollama pull nomic-embed-text
# Alternatives: mxbai-embed-large (1024 dims), nomic-embed-text (768 dims, default)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Ollama Privacy Hardening (recommended) ───────────────────────────────────
# Disable Ollama cloud models to ensure all inference stays on-machine.
# When set, Ollama will refuse to route requests to cloud-hosted models.
# Strongly recommended for deployments handling sensitive or regulated data.
OLLAMA_NO_CLOUD=1

# ── Budget Cap (E5) ───────────────────────────────────────────────────────────
# Global monthly AI spending cap in EUR. 0 = unlimited.
# Can also be set via the Budget section in Settings (stored in the database).
MONTHLY_BUDGET_CAP=0

# ── Email / SMTP (optional) ───────────────────────────────────────────────────
# If not set, uses Ethereal test account in dev (preview URL logged to console).
# In production, configure a real SMTP provider (e.g. SendGrid, Mailgun, SES).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Anton by openEXPERT <noreply@openexpert.ai>
EMAIL_NOTIFICATIONS_ENABLED=false

# ── OAuth — Google (optional) ─────────────────────────────────────────────────
# Enables "Continue with Google" button on the login page.
# Get credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — GitHub (optional) ─────────────────────────────────────────────────
# Enables "Continue with GitHub" button on the login page.
# Get credentials at: https://github.com/settings/developers
# Callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Enterprise OIDC SSO (optional) ────────────────────────────────────────────
# Enables "Enterprise SSO (Azure AD / Okta)" button on the login page.
# Works with any OpenID Connect-compliant identity provider.
#
# Azure AD:  OIDC_ISSUER_URL=https://login.microsoftonline.com/{tenant-id}/v2.0
# Okta:      OIDC_ISSUER_URL=https://your-org.okta.com/oauth2/default
# Auth0:     OIDC_ISSUER_URL=https://your-tenant.auth0.com/
#
# Register a web application in your IdP and add this callback URL:
#   http://localhost:3001/api/auth/oidc/callback
#
# Set OIDC_ISSUER_URL + OIDC_CLIENT_ID to enable the SSO button.
# OIDC_CLIENT_SECRET is optional for public clients (PKCE-only flows).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/api/auth/oidc/callback

# ── Markets Pillar Data Providers (optional) ──────────────────────────────────
# Financial Modeling Prep — global prices, news, economic calendar (250 calls/day free)
# Get key at: https://site.financialmodelingprep.com/developer
FMP_API_KEY=

# End of Day Historical Data — OMX Stockholm, EU, India, Japan (20 calls/day free)
# Get key at: https://eodhd.com/register
EODHD_API_KEY=

# ── P2P / Community (optional) ────────────────────────────────────────────────
# Allow P2P message delivery to private/LAN IP addresses (for local ANTON-to-ANTON connections).
# Set to true when connecting ANTON instances on the same network.
ALLOW_PRIVATE_P2P=false

# Enable mDNS/Bonjour discovery so companion apps and peer ANTONs can find this instance on the LAN.
APP_GATEWAY_MDNS=false

# Network bind address (2026-07-17 hardening). Default: 127.0.0.1 (loopback only) —
# in solo mode every /api request is auto-admin, so a LAN bind hands the admin surface
# to every device on the network. Set true to listen on 0.0.0.0 for LAN phone pairing.
# If unset, LAN intent is inferred from APP_GATEWAY_PUBLIC_URL / APP_GATEWAY_MDNS=true /
# APP_GATEWAY_LAN_BROWSE=true (existing setups keep working). USB pairing (adb reverse)
# and mesh/relay pairing work fine on loopback.
ANTON_LAN_BIND=false

# Walk-up self-registration on the app gateway (POST /api/app/register[-simple]).
# Default OFF: an open registration endpoint mints a session token for anyone who can
# reach the port, and sessions unlock LLM-spending routes. Devices onboard via the
# admin enrollment QR instead. Set true only if you deliberately want open onboarding.
APP_GATEWAY_OPEN_REGISTRATION=false

# Defense-in-depth on the org-less sensitive routes (agent LLM queries, agent data,
# markets, radar). Default ON: a session alone is not enough — the user must be
# operator-approved (paired via the enrollment ritual → app_devices, OR an active
# org member). Self-registered users are refused these routes. Enrolled devices
# always pass, so this is a no-op when open registration is off. Set false only if
# a legitimate device onboarded without a device record and gets wrongly blocked.
APP_GATEWAY_REQUIRE_APPROVAL=true

# Publicly-reachable HTTPS URL for THIS ANTON instance (no trailing slash).
# Used by:
#  - Companion App enrollment QRs (so phones can reach this instance over WAN)
#  - Portal descriptors as `portal.originEndpoint` — visitors join with
#    /api/portals/visit/<address>/page and /capabilities/<id>/invoke to render
#    pages and invoke capabilities. Without this, walkthrough-built portals
#    are reachable only on LAN/local.
# APP_GATEWAY_PUBLIC_URL=https://my-anton.example.com

# ── Portals Registry (optional) ──────────────────────────────────────────────
# Portals are local-first: without any registry configured, a portal you build
# is reachable on this machine and your LAN only ("local_only"). To make a
# portal discoverable by other ANTON instances and the Comm app, publish it to
# the relay's HTTP registry: set RELAY_PORTAL_SUBMIT_URL and provide the KYC
# details requested in the portal builder's publish step — submissions are
# reviewed before they appear in federated search. Local-only portals keep
# working either way; publishing is opt-in per portal.
#
# RELAY_PORTAL_SUBMIT_URL — the ACTIVE publishing path. Base URL of the relay
# registry API (include the /v1 suffix). Public default relay:
# RELAY_PORTAL_SUBMIT_URL=https://relay.futurechain.eu/v1
#
# PORTAL_REGISTRY_URL — the LEGACY transparency-log registry protocol
# (DORMANT: no public server is deployed). Only set this if you self-host a
# registry server implementing the Registry Protocol spec. Setting it also
# enables the STH freshness monitor.
# PORTAL_REGISTRY_URL=
#
# Set to true to disable the Signed-Tree-Head freshness monitor even when
# PORTAL_REGISTRY_URL is configured.
# PORTAL_STH_MONITOR_DISABLED=false

# ── Companion App Push (optional) ────────────────────────────────────────────
# Enable real push dispatch (APNs / FCM / web-push). When false, dispatch is a
# no-op that only logs the intent — useful for development.
# APP_GATEWAY_PUSH=false

# Web Push (PWA) — generate keys with `npx web-push generate-vapid-keys`.
# Required for PWA push to function. Without these, web-push tokens fail
# at dispatch time with a clear error.
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_SUBJECT=mailto:admin@anton.local

# APNs (iOS) — iOS fast-follow: the dispatch path is a graceful no-op for now
# (logs once, never throws), so a mixed token set never crashes the dispatcher.
# Wire @parse/node-apn when the iOS project exists.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=

# FCM (Android) — the Companion-app gateway FCM dispatch is now CODE-COMPLETE.
# Set FCM_SERVICE_ACCOUNT_JSON (path to, OR inline, a Firebase service-account
# .json) to enable real wake pushes to Companion Android devices. Absent → the
# dispatcher is a graceful no-op (one-time warning). Uses FCM HTTP v1 via Node
# crypto (NO firebase-admin dependency). Build the Companion app with
# VITE_FIREBASE_ENABLED=true AND android/app/google-services.json present so the
# client registers a token. See docs/FCM_OPERATOR_RUNBOOK.md.
# NOTE: the ANTON COMM app's kill-proof message push (Phase 3) is a SEPARATE
# path that lives on the RELAY — configure FCM_SERVICE_ACCOUNT_JSON on the relay
# host for that one.
# FCM_SERVICE_ACCOUNT_JSON=    # path to (or inline) service-account JSON file
# FCM_PROJECT_ID=              # optional; defaults to project_id from the key

# ── Companion App Identity (optional but strongly recommended) ───────────────
# 32-byte hex-encoded key that AES-256-GCM-encrypts the instance Ed25519
# private key in `instance_identity.privkey_encrypted`. Without this the
# privkey is stored plaintext and a one-time warning is logged.
# INSTANCE_KEY_ENCRYPTION_KEY=

# ── Public Relay (optional — for cross-network ANTON-to-ANTON) ────────────────
# URL of a public relay server. When set, messages that can't be delivered directly
# are stored on the relay for the recipient to collect. Works across networks.
# PUBLIC_RELAY_URL=https://relay.openexpert.io

# API key for authenticating with the public relay.
# PUBLIC_RELAY_API_KEY=your-relay-api-key-here

# HMAC secret for signing relay requests (optional, extra security layer).
# PUBLIC_RELAY_HMAC_SECRET=your-hmac-secret-here

# ── Relay Server Settings (if this ANTON acts as a relay for others) ──────────
# Set to true to allow other ANTON instances to store/collect messages on this server.
# RELAY_PUBLIC=false

# Comma-separated API keys that are allowed to use this relay (required when RELAY_PUBLIC=true).
# RELAY_API_KEYS=key1,key2,key3

# Comma-separated IP addresses/ranges allowed to access this relay.
# Empty = allow all (when API key is set). Supports wildcards: 192.168.1.*
# RELAY_ALLOWED_IPS=

# HMAC secret for validating signed relay requests (optional).
# RELAY_HMAC_SECRET=

# How long relay messages are stored before expiry (default 30, max 90 days).
# RELAY_MESSAGE_TTL_DAYS=30

# ── Orchestrator Model Overrides (optional) ──────────────────────────────────
# Override the AI models used by the Orchestrator engine.
# Defaults to fast Haiku for heartbeats and powerful Opus for briefings.
# ORCHESTRATOR_HEARTBEAT_MODEL=claude-haiku-4-5-20251001
# ORCHESTRATOR_BRIEFING_MODEL=claude-opus-4-8

# ── Cost-Control Pause Flags (optional) ──────────────────────────────────────
# Set to true to pause expensive automated work without uninstalling crons.
# Useful when LLM budget needs to be redirected.
#
# MARKETS_AUTOMATION — explicit OPT-IN for the token/data-spending markets
# crons (LLM intelligence phases + external FMP/news/RSS fetches, ~20 jobs);
# leaving it unset costs nothing: only the free deterministic loops run (NAV,
# MV refresh, price-graded prediction verifier + calibration, pattern→weight
# feedback, lifecycle sweeps, loop-health watchdog). Set to true to enable
# full markets automation — expect daily Anthropic token spend plus external
# data-API calls; the pause flags below still work as overrides when on.
# MARKETS_AUTOMATION=false
#
# MARKETS_THINKING_DISABLED — skips every LLM-spending markets phase:
#   atom extraction (backlog), daily intelligence (Phase 4),
#   weekly pulse (Phase 8), prediction validation + fundamental analysis
#   (Phases 6, 7), and the matching catch-up steps. NAV updates, price syncs,
#   prediction checkpoints (price-only), event triggers, the prediction
#   verifier and materialized-view refreshes still run — they are free.
# MARKETS_THINKING_DISABLED=false
#
# MARKETS_FETCH_DISABLED — skips every external market data fetch
# (FMP prices/fundamentals, news, RSS). The in-DB processing pipeline still
# runs (so a backlog can be drained) unless MARKETS_THINKING_DISABLED is also
# set. Set this if you want to stop hitting paid data APIs.
# MARKETS_FETCH_DISABLED=false
#
# RADAR_AUTOMATION_DISABLED — disables radar auto-scan + cron-scheduled radar
# scans. Manual scans from the UI still work.
# RADAR_AUTOMATION_DISABLED=false

# ── Missions ────────────────────────────────────────────────────────────────
#
# MISSIONS_RUNNER_DISABLED — disables the background mission runner (the
# ~20s tick that advances every 'active' mission automatically). With the
# runner off, missions only advance when you click "Advance" in the UI or
# call POST /api/missions/:id/advance. The runner never auto-starts
# 'briefed' missions (plan approval is always a human step) and respects
# every checkpoint, autonomy gate, and budget pause either way.
# MISSIONS_RUNNER_DISABLED=false
