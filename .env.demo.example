# ─────────────────────────────────────────────────────────────────────────────
# ANTON public demo — the .env for a showcase server (DEMO_MODE=true)
#
# Copy to .env on the demo server and fill in every <...>. The runbook is
# docs/deployment/public-demo.md. Everything not listed here keeps the
# defaults documented in .env.example.
#
# The showcase runs its models on OpenRouter only. It has NO Anthropic key and
# NO subscription engine: either would let strangers run Claude on your
# account. The OpenRouter key itself is entered in Settings → Local models →
# OpenAI-compatible endpoints (stored encrypted in the database), not here.
# That endpoint's extra body must be
#   {"provider":{"only":["inceptron"],"zdr":true,"data_collection":"deny"}}
# (the OpenRouter preset fills it in): in demo mode ANTON sends nothing to
# OpenRouter while zdr, data_collection "deny" or provider.only is missing, or
# while provider.only names a provider outside DEMO_ALLOWED_PROVIDERS (below).
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────────────────
# A demo requires team mode; ANTON refuses to start DEMO_MODE=true in solo mode.
DEPLOYMENT_MODE=team
DEMO_MODE=true
NODE_ENV=production
PORT=3001

# ── Secrets (generate each one; never reuse the dev machine's) ───────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<48 random bytes, hex>
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<32 random bytes, hex — encrypts the OpenRouter key at rest>
INSTANCE_KEY_ENCRYPTION_KEY=<32 random bytes, hex>
# openssl rand -hex 32 — /mcp asks for it; nginx also blocks /mcp.
MCP_SECRET=<openssl rand -hex 32>
# openssl rand -hex 32 — keys the pseudonymous `user` id sent to OpenRouter
# with every call (an HMAC of the visitor's account id, so OpenRouter can act
# against one account instead of the whole key). It must differ from
# JWT_SECRET and be at least 32 characters: a demo refuses to start otherwise.
LLM_USER_HASH_SECRET=<openssl rand -hex 32>
# How long a sign-in lasts. Demo mode caps it at 8h whatever this says (the
# privacy notice promises 8 hours at the latest); a shorter value applies.
JWT_EXPIRY=8h

# ── Who runs the demo ────────────────────────────────────────────────────────
# The controller's legal name, shown as "Operated by …" on the sign-in page and
# in the privacy notice and terms (lag 2002:562 8 §). The server warns at
# start while it is unset.
DEMO_OPERATOR_NAME=<controller legal name>

# ── Build ────────────────────────────────────────────────────────────────────
# Build the web client for the demo with ANTON_DEMO_BUILD=true:
#   ANTON_DEMO_BUILD=true pnpm run build
# No service worker is generated or registered, so no offline copy of the
# pages is kept in visitors' browsers. It is read by the build only, not by the
# running server, so setting it in this file does nothing.

# ── Network (nginx on the same machine terminates TLS) ───────────────────────
TRUST_PROXY=loopback
CORS_ORIGINS=https://<demo host>
APP_PUBLIC_URL=https://<demo host>
BASE_URL=https://<demo host>
# ANTON listens on 127.0.0.1 only; keep it that way.
ANTON_LAN_BIND=false

# ── Database (its own database, never shared with another ANTON) ────────────
DATABASE_URL=postgresql://anton:<password>@127.0.0.1:5432/anton_demo

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=/srv/anton/uploads
OUTPUT_DIR=/srv/anton/outputs
WORKSPACES_DIR=/srv/anton/workspaces
MAX_FILE_SIZE_MB=10
# What one visitor may keep in uploads (0 = no cap). Uploads share the disk
# with PostgreSQL unless /srv/anton is its own filesystem (see the runbook).
DEMO_USER_UPLOAD_MB=50
DEMO_USER_UPLOAD_FILES=50
# Uploads, exports and version saves per visitor per 10 minutes.
DEMO_USER_WRITES_PER_10_MIN=30
# No server folders are readable from the web.
ALLOWED_FOLDER_PATHS=

# ── Who can sign up ──────────────────────────────────────────────────────────
# The invite code you hand out at demos. Unset = sign-up closed (unless
# DEMO_SIGNUP_OPEN=true, which lets anyone on the internet make an account).
DEMO_SIGNUP_CODE=<a code you hand out>
# DEMO_SIGNUP_OPEN=false
# Accounts, and everything in them, are deleted this many days after sign-up.
DEMO_ACCOUNT_TTL_DAYS=30
# Monthly token budget of each demo account (0 = unlimited).
DEMO_USER_MONTHLY_TOKENS=500000
# New demo accounts per rolling 24 hours, instance-wide (0 = no cap).
DEMO_MAX_SIGNUPS_PER_DAY=100
# Sign-up attempts per IP address per hour (successes and failures alike).
DEMO_SIGNUPS_PER_IP_PER_HOUR=3

# ── What visitors see ────────────────────────────────────────────────────────
# Full model ids the model picker offers visitors (comma-separated). Each must
# also be on the endpoint's allowed-models list (Settings → Local models).
DEMO_OFFERED_MODELS=compat:openrouter:z-ai/glm-5.3-flash
# Modules kept off the demo, because they invite health, employment, credit or
# criminal-offence data that the demo must not receive. Visitors neither see
# nor run them; admins still do. Area ids and module ids (the folder names
# under server/areas/<area>/modules/), comma-separated. These are the lists
# the privacy notice relies on, and demo mode uses them even when both lines
# are left out; a list you set replaces the built-in one, and the server warns
# at start about each of these ids it leaves out. "none" turns a list off.
#   Areas: health, community health, HR, workers' rights.
#   Modules: credit risk and credit scoring (credit-risk,
#   fintech-credit-risk-assessment, microfinance-credit-scoring,
#   credit-score-builder); CV writing (cv-writer); employment and social
#   protection (employment-rights, social-protection-navigator); criminal law
#   and investigations (court-process-demystifier, alert-investigation,
#   investigation-support, ivts-detection-investigation,
#   blockchain-investigation, investigative-research, sar-quality-check,
#   daily-screening-review, sanctions-advisory). The rest of the fcp area stays.
DEMO_HIDDEN_AREAS=healthcare,community-health,hr,workers-rights
DEMO_HIDDEN_MODULES=credit-risk,fintech-credit-risk-assessment,microfinance-credit-scoring,credit-score-builder,cv-writer,employment-rights,social-protection-navigator,talent-discovery,talent-ad-generator,talent-ad-generation,talent-assessment,talent-aspiration,court-process-demystifier,alert-investigation,investigation-support,ivts-detection-investigation,blockchain-investigation,investigative-research,sar-quality-check,daily-screening-review,sanctions-advisory
# The OpenRouter providers a visitor's request may go to, comma-separated
# (default: inceptron). Every provider in the endpoint's provider.only must be
# one of these, or the request is refused before anything is sent: the privacy
# notice names Inceptron as the only provider, and the transfer assessment
# covers that one. An endpoint saved from an older preset
# (["inceptron","nextbit"]) is refused until its extra body is corrected.
DEMO_ALLOWED_PROVIDERS=inceptron
# Pillars besides Work (always on), comma-separated: school, life, pathfinder,
# markets, community, payments, portals, missions, procure, civic, grow.
# Each adds its API prefix to what visitors may reach. Default: Work only.
DEMO_ENABLED_PILLARS=
# More API prefixes visitors may reach, comma-separated, each optionally
# METHOD: or METHOD|METHOD:. Examples: /renderers (the Transform panel),
# POST:/modules/smart-search (the "find the right module" search). Both call
# the model.
DEMO_EXTRA_ROUTES=
# Model calls after each answer, besides the answer: conclusion (default — only
# the session conclusion the page shows), none, or all (also the quality score
# and the structured extraction, as on every other install). Each call spends
# budget, and several at once get rate-limited on a narrow provider pin.
DEMO_POST_ANSWER_CALLS=conclusion

# ── Spend caps on priced model calls (UTC day) ───────────────────────────────
# The OpenRouter key's own credit limit is the hard stop; these stop earlier
# inside ANTON, with a clear message to the visitor.
LLM_DAILY_SPEND_CAP_USD=3
LLM_USER_DAILY_SPEND_CAP_USD=0.25

# ── Embeddings: local Ollama, embedding model only (CPU is enough) ───────────
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Off on a demo ────────────────────────────────────────────────────────────
# Demo mode forces these four off anyway; set so the .env reads true.
MARKETS_SCHEDULE_DISABLED=true
MISSIONS_RUNNER_DISABLED=true
MEMORY_SWEEP_DISABLED=true
RADAR_AUTOMATION_DISABLED=true
# No companion-app gateway, no web checkout, no mesh relay on the showcase.
APP_GATEWAY_ENABLED=false
WEB_CHECKOUT_SWEEP_DISABLED=true
# ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY, MISTRAL_API_KEY,
# AZURE_OPENAI_*: leave unset.
# SDK_ENGINE_ENABLED / CODEX_ENGINE_ENABLED: leave unset (off).
# GOOGLE_CLIENT_ID / GITHUB_CLIENT_ID: leave unset (demo mode refuses them anyway).
# ANTON_MESH_RELAYS, PORTAL_REGISTRY_URL, APP_GATEWAY_PUBLIC_URL: leave unset.
# METRICS_ENABLED: leave unset.
